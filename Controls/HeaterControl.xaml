<UserControl x:Class="Small_square_cavity_coating_machine.Controls.HeaterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="88"
             MinWidth="250"
             MinHeight="76">
    <Border Padding="8,4"
            Background="#F8FAFC"
            BorderBrush="#AEBCC8"
            BorderThickness="1.5"
            CornerRadius="7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                           Margin="4,0"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#1F2D3D"
                           HorizontalAlignment="center"
                           VerticalAlignment="Center"/>
                <controls:ShutterSwitchButton Grid.Row="1"
                                              Width="100"
                                              Height="40"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              DeviceName="{Binding DisplayName, ElementName=Root}"
                                              IsOn="{Binding IsRunning, ElementName=Root}"
                                              OnText="启动"
                                              OffText="停止"
                                              IsInterlockReleased="{Binding IsInterlockReleased, ElementName=Root}"
                                              IsFaulted="{Binding IsFaulted, ElementName=Root}"
                                              ShowInterlockIndicator="False"
                                              Command="{Binding ToggleCommand, ElementName=Root}"/>
            </Grid>

            <Border Grid.Column="1"
                    Margin="0,4"
                    Background="#D6DEE5"/>

            <Grid Grid.Column="2" Margin="12,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前温度"
                               FontSize="20"
                               Foreground="#52616B"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentTemperature, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#147BD1"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="℃"
                               Margin="6,0,0,0"
                               FontSize="24"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="预设温度"
                               FontSize="20"
                               Foreground="#52616B"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="SetpointTextBox"
                             Grid.Column="1"
                             Height="34"
                             Padding="4,1"
                             FontSize="24"
                             Text="{Binding SetpointTemperature, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="SetpointTextBox_PreviewKeyDown"
                             LostKeyboardFocus="SetpointTextBox_LostKeyboardFocus"/>
                    <TextBlock Grid.Column="2"
                               Text="℃"
                               Margin="6,0,0,0"
                               FontSize="24"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="Small_square_cavity_coating_machine.Controls.PowerSupplyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="124"
             MinWidth="280"
             MinHeight="108">
    <Border Padding="10,8"
            Background="#F8FAFC"
            BorderBrush="#AEBCC8"
            BorderThickness="1.5"
            CornerRadius="7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="118"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1F2D3D"
                       VerticalAlignment="Center"/>

            <Grid Grid.Column="1" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="设定功率" Width="62" Foreground="#52616B" VerticalAlignment="Center"/>
                    <TextBox x:Name="SetpointTextBox"
                             Width="72"
                             Height="24"
                             Padding="4,1"
                             Text="{Binding SetpointPower, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="SetpointTextBox_PreviewKeyDown"
                             LostKeyboardFocus="SetpointTextBox_LostKeyboardFocus"/>
                    <TextBlock Text=" W" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="#52616B">
                    <Run Text="当前功率  "/>
                    <Run Text="{Binding MeasuredPower, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}"
                         FontWeight="Bold" Foreground="#147BD1"/>
                    <Run Text=" W"/>
                </TextBlock>
                <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="#52616B">
                    <Run Text="当前电压  "/>
                    <Run Text="{Binding MeasuredVoltage, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}"
                         FontWeight="Bold" Foreground="#147BD1"/>
                    <Run Text=" V"/>
                </TextBlock>
                <TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="#52616B">
                    <Run Text="当前电流  "/>
                    <Run Text="{Binding MeasuredCurrent, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.00}}"
                         FontWeight="Bold" Foreground="#147BD1"/>
                    <Run Text=" A"/>
                </TextBlock>
            </Grid>

            <controls:ShutterSwitchButton Grid.Column="2"
                                          Width="112"
                                          Height="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          DeviceName="{Binding DisplayName, ElementName=Root}"
                                          IsOn="{Binding IsRunning, ElementName=Root}"
                                          OnText="启动"
                                          OffText="停止"
                                          IsInterlockReleased="{Binding IsInterlockReleased, ElementName=Root}"
                                          IsFaulted="{Binding IsFaulted, ElementName=Root}"
                                          Command="{Binding ToggleCommand, ElementName=Root}"/>
        </Grid>
    </Border>
</UserControl>

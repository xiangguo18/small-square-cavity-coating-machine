<UserControl x:Class="Small_square_cavity_coating_machine.Controls.PowerSupplyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="124"
             MinWidth="280"
             MinHeight="108">
    <Border Padding="10,4"
            Background="#F8FAFC"
            BorderBrush="#AEBCC8"
            BorderThickness="1.5"
            CornerRadius="7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid RenderTransformOrigin="0.496,0.477">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52*"/>
                    <RowDefinition Height="61*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                           Margin="4,0,4,0"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#1F2D3D" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Height="32"/>
                <controls:ShutterSwitchButton Grid.Row="1"
                                              Width="100"
                                              Height="40"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              DeviceName="{Binding DisplayName, ElementName=Root}"
                                              IsOn="{Binding IsRunning, ElementName=Root}"
                                              OnText="启动"
                                              OffText="停止"
                                              IsInterlockReleased="{Binding IsInterlockReleased, ElementName=Root}"
                                              IsFaulted="{Binding IsFaulted, ElementName=Root}"
                                              ShowInterlockIndicator="False"
                                              Command="{Binding ToggleCommand, ElementName=Root}"/>
            </Grid>

            <Border Grid.Column="1"
                    Margin="0,4"
                    Background="#D6DEE5"/>

            <Grid Grid.Column="2" Margin="12,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设定功率" FontSize="20" Foreground="#52616B" VerticalAlignment="Center"/>
                    <TextBox x:Name="SetpointTextBox"
                             Grid.Column="1"
                             Height="30"
                             Padding="4,1"
                             FontSize="24"
                             Text="{Binding SetpointPower, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="SetpointTextBox_PreviewKeyDown"
                             LostKeyboardFocus="SetpointTextBox_LostKeyboardFocus"/>
                    <TextBlock Grid.Column="2" Text="W" FontSize="24" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前功率" FontSize="20" Foreground="#52616B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding MeasuredPower, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}" FontSize="24" FontWeight="Bold" Foreground="#147BD1" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="W" FontSize="24" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前电压" FontSize="20" Foreground="#52616B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding MeasuredVoltage, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}" FontSize="24" FontWeight="Bold" Foreground="#147BD1" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="V" FontSize="24" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前电流" FontSize="20" Foreground="#52616B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding MeasuredCurrent, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.00}}" FontSize="24" FontWeight="Bold" Foreground="#147BD1" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="A" FontSize="24" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>

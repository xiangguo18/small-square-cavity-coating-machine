<UserControl x:Class="Small_square_cavity_coating_machine.Controls.VacuumGaugeSymbolControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="88"
             d:DesignHeight="88"
             MinWidth="24"
             MinHeight="24">
    <Viewbox Stretch="Uniform">
        <Button x:Name="GaugeSymbolButton"
                Width="88"
                Height="88"
                Padding="0"
                BorderThickness="0"
                Background="Transparent"
                Focusable="{Binding CanToggle, ElementName=Root}"
                IsHitTestVisible="{Binding CanToggle, ElementName=Root}"
                Command="{Binding ToggleCommand, ElementName=Root}">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanToggle, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Canvas Width="88"
                                Height="88">
                            <Canvas.RenderTransform>
                                <RotateTransform Angle="{Binding SymbolRotation, ElementName=Root}"
                                                 CenterX="44"
                                                 CenterY="44"/>
                            </Canvas.RenderTransform>
                            <Line X1="44" Y1="76" X2="44" Y2="88"
                                  Stroke="#263238"
                                  StrokeThickness="4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                            <Ellipse x:Name="GaugeBody"
                                     Canvas.Left="10"
                                     Canvas.Top="10"
                                     Width="68"
                                     Height="68"
                                     Fill="#AEB8BF"
                                     Stroke="#263238"
                                     StrokeThickness="3"/>
                        </Canvas>
                        <Path Data="M 21,25 L 44,65 L 67,25 M 16,45 L 72,45"
                              Fill="Transparent"
                              Stroke="#263238"
                              StrokeThickness="4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                        <Border x:Name="ValveStatusBadge"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#AEB8BF"
                                BorderBrush="#263238"
                                BorderThickness="2"
                                CornerRadius="12">
                            <TextBlock Text="阀"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsReadingEnabled, ElementName=Root}"
                                     Value="True">
                            <Setter TargetName="GaugeBody"
                                    Property="Fill"
                                    Value="#55C878"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowValveStatus, ElementName=Root}"
                                     Value="False">
                            <Setter TargetName="ValveStatusBadge"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsValveOpen, ElementName=Root}"
                                     Value="True">
                            <Setter TargetName="ValveStatusBadge"
                                    Property="Background"
                                    Value="#55C878"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsValveFaulted, ElementName=Root}"
                                     Value="True">
                            <Setter TargetName="ValveStatusBadge"
                                    Property="Background"
                                    Value="#EF4444"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFaulted, ElementName=Root}"
                                     Value="True">
                            <Setter TargetName="GaugeBody"
                                    Property="Fill"
                                    Value="#EF4444"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Viewbox>
</UserControl>

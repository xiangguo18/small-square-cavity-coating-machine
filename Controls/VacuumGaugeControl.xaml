<UserControl x:Class="Small_square_cavity_coating_machine.Controls.VacuumGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="290"
             d:DesignHeight="88"
             MinWidth="80"
             MinHeight="40">
    <UserControl.Resources>
        <controls:NumericValueWithUnitConverter x:Key="NumericValueConverter"/>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <!-- 根据符号和文本框的实际组合尺寸，完整缩放到控件的 Width/Height 内。 -->
        <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--
                SymbolRotation 只作用于圆圈和连接杆。
                使用以圆心为中心的 88×88 正方形区域，旋转到任意方向都不会改变符号占位。
            -->
            <Button x:Name="GaugeSymbolButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="88"
                    Height="88"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Focusable="{Binding CanToggle, ElementName=Root}"
                    IsHitTestVisible="{Binding CanToggle, ElementName=Root}"
                    Command="{Binding ToggleCommand, ElementName=Root}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Cursor" Value="Arrow"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanToggle, ElementName=Root}"
                                         Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Canvas Width="88"
                                    Height="88">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="{Binding SymbolRotation, ElementName=Root}"
                                                     CenterX="44"
                                                     CenterY="44"/>
                                </Canvas.RenderTransform>
                                <Line X1="44" Y1="76" X2="44" Y2="88"
                                      Stroke="#263238"
                                      StrokeThickness="4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                                <Ellipse x:Name="GaugeBody"
                                         Canvas.Left="10"
                                         Canvas.Top="10"
                                         Width="68"
                                         Height="68"
                                         Fill="#AEB8BF"
                                         Stroke="#263238"
                                         StrokeThickness="3"/>
                            </Canvas>

                            <!-- 高真空计内部符号始终保持正向，不跟随圆圈和连接杆旋转。 -->
                            <Path Data="M 21,25 L 44,65 L 67,25 M 16,45 L 72,45"
                                  Fill="Transparent"
                                  Stroke="#263238"
                                  StrokeThickness="4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsReadingEnabled, ElementName=Root}"
                                         Value="True">
                                <Setter TargetName="GaugeBody"
                                        Property="Fill"
                                        Value="#55C878"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 名称和真空度文本框可通过 ReadoutWidth、ReadoutHeight 独立调整。 -->
            <Border x:Name="GaugeReadout"
                    Width="{Binding ReadoutWidth, ElementName=Root}"
                    Height="{Binding ReadoutHeight, ElementName=Root}"
                    BorderBrush="#263238"
                    BorderThickness="2"
                    CornerRadius="3"
                    Background="#102535"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Grid.Row" Value="1"/>
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Margin" Value="4,0,0,0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TextPlacement, ElementName=Root}"
                                         Value="{x:Static controls:GaugeTextPlacement.Left}">
                                <Setter Property="Grid.Row" Value="1"/>
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TextPlacement, ElementName=Root}"
                                         Value="{x:Static controls:GaugeTextPlacement.Top}">
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.Column" Value="1"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TextPlacement, ElementName=Root}"
                                         Value="{x:Static controls:GaugeTextPlacement.Bottom}">
                                <Setter Property="Grid.Row" Value="2"/>
                                <Setter Property="Grid.Column" Value="1"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!--
                    文本使用独立的设计基准进行缩放。
                    ReadoutWidth/ReadoutHeight 改变时只缩放文本框及其文字，不影响圆形符号。
                -->
                <Viewbox Stretch="Uniform"
                         StretchDirection="Both">
                    <Grid Width="200"
                          Height="64">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                                   Foreground="#DCEBFA"
                                   FontSize="20"
                                   Margin="9,3,9,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LiveReading"
                                   Grid.Row="1"
                                   Foreground="#51C8FF"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Margin="9,0,9,4"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReadingEnabled, ElementName=Root}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource NumericValueConverter}">
                                    <Binding Path="VacuumValue" ElementName="Root"/>
                                    <Binding Path="ValueFormat" ElementName="Root"/>
                                    <Binding Path="Unit" ElementName="Root"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="1"
                                   Foreground="#AEB8BF"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Margin="9,0,9,4"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReadingEnabled, ElementName=Root}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="-- "/>
                            <Run Text="{Binding Unit, ElementName=Root}"/>
                        </TextBlock>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>

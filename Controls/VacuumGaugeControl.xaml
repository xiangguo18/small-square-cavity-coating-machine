<UserControl x:Class="Small_square_cavity_coating_machine.Controls.VacuumGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="290"
             d:DesignHeight="88"
             MinWidth="80"
             MinHeight="40">
    <Viewbox Stretch="Uniform">
        <!-- 兼容原公开接口；读数面板与设备符号已拆为可独立复用的控件。 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:VacuumGaugeSymbolControl Grid.Row="1"
                                               Grid.Column="1"
                                               Width="88"
                                               Height="88"
                                               SymbolRotation="{Binding SymbolRotation, ElementName=Root}"
                                               IsReadingEnabled="{Binding IsReadingEnabled, ElementName=Root}"
                                               IsFaulted="{Binding IsFaulted, ElementName=Root}"
                                               ShowValveStatus="{Binding ShowValveStatus, ElementName=Root}"
                                               IsValveOpen="{Binding IsValveOpen, ElementName=Root}"
                                               IsValveFaulted="{Binding IsValveFaulted, ElementName=Root}"
                                               CanToggle="{Binding CanToggle, ElementName=Root}"
                                               ToggleCommand="{Binding ToggleCommand, ElementName=Root}"/>

            <controls:VacuumGaugeReadoutControl x:Name="GaugeReadout"
                                                Width="{Binding ReadoutWidth, ElementName=Root}"
                                                Height="{Binding ReadoutHeight, ElementName=Root}"
                                                DisplayName="{Binding DisplayName, ElementName=Root}"
                                                VacuumValue="{Binding VacuumValue, ElementName=Root}"
                                                IsReadingEnabled="{Binding IsReadingEnabled, ElementName=Root}"
                                                Unit="{Binding Unit, ElementName=Root}"
                                                ValueFormat="{Binding ValueFormat, ElementName=Root}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                <controls:VacuumGaugeReadoutControl.Style>
                    <Style TargetType="{x:Type controls:VacuumGaugeReadoutControl}">
                        <Setter Property="Grid.Row" Value="1"/>
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Margin" Value="4,0,0,0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TextPlacement, ElementName=Root}"
                                         Value="{x:Static controls:GaugeTextPlacement.Left}">
                                <Setter Property="Grid.Row" Value="1"/>
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TextPlacement, ElementName=Root}"
                                         Value="{x:Static controls:GaugeTextPlacement.Top}">
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.Column" Value="1"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TextPlacement, ElementName=Root}"
                                         Value="{x:Static controls:GaugeTextPlacement.Bottom}">
                                <Setter Property="Grid.Row" Value="2"/>
                                <Setter Property="Grid.Column" Value="1"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:VacuumGaugeReadoutControl.Style>
            </controls:VacuumGaugeReadoutControl>
        </Grid>
    </Viewbox>
</UserControl>

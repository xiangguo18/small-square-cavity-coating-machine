<UserControl x:Class="Small_square_cavity_coating_machine.Controls.VacuumGaugeReadoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="200"
             d:DesignHeight="64"
             MinWidth="48"
             MinHeight="24">
    <UserControl.Resources>
        <controls:NumericValueWithUnitConverter x:Key="NumericValueConverter"/>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform"
             StretchDirection="Both">
        <Border Width="200"
                Height="64"
                BorderBrush="#263238"
                BorderThickness="2"
                CornerRadius="3"
                Background="#102535"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                           Foreground="#DCEBFA"
                           FontSize="20"
                           Margin="9,3,9,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LiveReading"
                           Grid.Row="1"
                           Foreground="#51C8FF"
                           FontSize="23"
                           FontWeight="Bold"
                           Margin="9,0,9,4"
                           TextAlignment="Right"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadingEnabled, ElementName=Root}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource NumericValueConverter}">
                            <Binding Path="VacuumValue" ElementName="Root"/>
                            <Binding Path="ValueFormat" ElementName="Root"/>
                            <Binding Path="Unit" ElementName="Root"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Row="1"
                           Foreground="#AEB8BF"
                           FontSize="23"
                           FontWeight="Bold"
                           Margin="9,0,9,4"
                           TextAlignment="Right"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadingEnabled, ElementName=Root}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="-- "/>
                    <Run Text="{Binding Unit, ElementName=Root}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>

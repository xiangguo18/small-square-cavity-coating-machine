<UserControl x:Class="Small_square_cavity_coating_machine.Controls.MfcFlowMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="200"
             d:DesignHeight="112"
             MinWidth="90"
             MinHeight="50">
    <UserControl.Resources>
        <controls:NumericValueWithUnitConverter x:Key="NumericValueConverter"/>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Border Width="200"
                Height="112"
                BorderBrush="#263238"
                BorderThickness="2"
                CornerRadius="4"
                Background="#F8FAFC">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1667B1" CornerRadius="2,2,0,0">
                    <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Grid Grid.Row="1" Background="#102535">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前流量"
                               Foreground="#DCEBFA"
                               FontSize="17"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="1"
                               Foreground="#51C8FF"
                               FontSize="17"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource NumericValueConverter}">
                                <Binding Path="CurrentFlow" ElementName="Root"/>
                                <Binding Path="ValueFormat" ElementName="Root"/>
                                <Binding Path="Unit" ElementName="Root"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="2" Background="#E8EDF2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设定流量"
                               Foreground="#37474F"
                               FontSize="17"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <TextBox x:Name="SetpointTextBox"
                             Grid.Column="1"
                             Height="30"
                             Padding="3,0"
                             BorderBrush="#90A4AE"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Text="{Binding SetpointFlow, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="SetpointTextBox_PreviewKeyDown"
                             LostKeyboardFocus="SetpointTextBox_LostKeyboardFocus"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Unit, ElementName=Root}"
                               Foreground="#263238"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0"/>
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>

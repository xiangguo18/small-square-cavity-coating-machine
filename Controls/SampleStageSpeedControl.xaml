<UserControl x:Class="Small_square_cavity_coating_machine.Controls.SampleStageSpeedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="520"
             d:DesignHeight="180"
             MinWidth="167"
             MinHeight="140">
    <UserControl.Resources>
        <Style x:Key="RotationButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="7,2"/>
            <Setter Property="Background" Value="#E7EDF2"/>
            <Setter Property="BorderBrush" Value="#7D8B95"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="FontSize" Value="22.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#55C878"/>
                    <Setter Property="BorderBrush" Value="#208844"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.78"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Padding="10,7"
            Background="#F8FAFC"
            BorderBrush="#AEBCC8"
            BorderThickness="1.5"
            CornerRadius="7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#1F2D3D"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>
                <Border Width="58" Height="26" Margin="0,0,6,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        BorderBrush="#7D8B95" BorderThickness="1" CornerRadius="13">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#AEB8BF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowStatusIndicator, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning, ElementName=Root}" Value="True">
                                    <Setter Property="Background" Value="#55C878"/>
                                    <Setter Property="BorderBrush" Value="#208844"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFaulted, ElementName=Root}" Value="True">
                                    <Setter Property="Background" Value="#EF4444"/>
                                    <Setter Property="BorderBrush" Value="#B91C1C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="White"
                               TextAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="停止"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning, ElementName=Root}" Value="True">
                                        <Setter Property="Text" Value="运行"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFaulted, ElementName=Root}" Value="True">
                                        <Setter Property="Text" Value="故障"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="8,0,8,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="83*"/>
                    <ColumnDefinition Width="228*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前转速"
                            FontSize="24"
                           Foreground="#52616B"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentSpeed, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}"
                            FontSize="32"
                           FontWeight="Bold"
                           Foreground="#147BD1"
                           TextAlignment="Right"
                           VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding Unit, ElementName=Root}"
                            Margin="5,0,0,0"
                            FontSize="24"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" Margin="8,1,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="设定转速"
                            FontSize="24"
                           Foreground="#52616B"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="SetpointTextBox"
                         Grid.Column="1"
                         Height="30"
                         Padding="4,1"
                         FontSize="24"
                         Text="{Binding SetpointSpeed, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.0}}"
                         HorizontalContentAlignment="Right"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="SetpointTextBox_PreviewKeyDown"
                         LostKeyboardFocus="SetpointTextBox_LostKeyboardFocus"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Unit, ElementName=Root}"
                            Margin="5,2,0,0"
                            FontSize="24"
                           VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="3"
                        Margin="0,11,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDirectionControls, ElementName=Root}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Content="正转"
                        Style="{StaticResource RotationButtonStyle}"
                        Tag="{Binding IsForwardRunning, ElementName=Root}"
                        Command="{Binding ForwardCommand, ElementName=Root}"/>
                <Button Content="反转"
                        Style="{StaticResource RotationButtonStyle}"
                        Tag="{Binding IsReverseRunning, ElementName=Root}"
                        Command="{Binding ReverseCommand, ElementName=Root}"/>
                <Button Content="停止"
                        Style="{StaticResource RotationButtonStyle}"
                        Tag="{Binding IsStopped, ElementName=Root}"
                        Command="{Binding StopCommand, ElementName=Root}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

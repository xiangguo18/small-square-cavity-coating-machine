<UserControl x:Class="Small_square_cavity_coating_machine.Controls.HmiPageLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Small_square_cavity_coating_machine.Models"
             xmlns:viewModels="clr-namespace:Small_square_cavity_coating_machine.ViewModels"
             Background="#EEF2F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid MinHeight="100"
              Margin="4,0,4,14">
            <TextBlock Text="{Binding PageTitle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="50"
                       FontWeight="SemiBold"
                       Foreground="#1F2D3D"/>

            <ContentControl Content="{Binding HeaderRightContent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
        </Grid>

        <ContentControl Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding PageContent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

        <Border Grid.Row="2"
                MinHeight="42"
                Margin="0,14,0,0"
                Padding="16,8"
                Background="#E5F1FB"
                BorderBrush="#B7D7F0"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="PlcConnectionLight"
                             Width="14"
                             Height="14"
                             Margin="0,0,8,0"
                             Stroke="#263238"
                             StrokeThickness="1.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlcConnectionState, Source={x:Static viewModels:ApplicationStatusViewModel.Instance}}"
                                                 Value="{x:Static models:PlcConnectionState.Connected}">
                                        <Setter Property="Fill" Value="#20D34A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PlcConnectionState, Source={x:Static viewModels:ApplicationStatusViewModel.Instance}}"
                                                 Value="{x:Static models:PlcConnectionState.ConnectionFailed}">
                                        <Setter Property="Fill" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2D3D">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="PLC未连接"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlcConnectionState, Source={x:Static viewModels:ApplicationStatusViewModel.Instance}}"
                                                 Value="{x:Static models:PlcConnectionState.Connected}">
                                        <Setter Property="Text" Value="PLC已连接"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PlcConnectionState, Source={x:Static viewModels:ApplicationStatusViewModel.Instance}}"
                                                 Value="{x:Static models:PlcConnectionState.ConnectionFailed}">
                                        <Setter Property="Text" Value="PLC连接失败"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#x26A0;"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="#E67E22"/>
                    <TextBlock Text="警告提醒！请到历史记录查看"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#9A4D00"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Page x:Class="Small_square_cavity_coating_machine.Views.IO"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
 Background="#EEF2F5" Title="I/O状态">
 <Page.Resources>
  <Style x:Key="EquipmentCellText" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E7F2FC"/><Setter Property="Foreground" Value="#20364C"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Page.Resources>
 <controls:HmiPageLayout PageTitle="I/O状态">
  <controls:HmiPageLayout.PageContent>
   <Border Background="White" BorderBrush="#D3DDE5" BorderThickness="1" CornerRadius="8" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12">
 <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
  <Button Content="全部" Command="{Binding FilterCommand}" CommandParameter="全部" Padding="18,7" Margin="0,0,8,0" FontSize="16"/>
  <Button Content="输入 IN" Command="{Binding FilterCommand}" CommandParameter="IN" Padding="18,7" Margin="0,0,8,0" FontSize="16"/>
  <Button Content="输出 OUT" Command="{Binding FilterCommand}" CommandParameter="OUT" Padding="18,7" FontSize="16"/>
 </StackPanel>
 <TextBlock Text="{Binding FilterText, StringFormat=当前筛选：{0}}" HorizontalAlignment="Right" Foreground="#527087"/>
</DockPanel>
     <DataGrid Grid.Row="1" FontSize="16" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E8EF"
      AlternatingRowBackground="#F5F8FC" Background="White" BorderBrush="#D3DDE5" RowHeight="42"
      SelectionMode="Single" EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="名称" Binding="{Binding Definition.Name}" Width="85"/>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="IN/OUT" Binding="{Binding Definition.Type}" Width="90"/>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="位置" Binding="{Binding Definition.Location}" Width="75"/>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="模块" Binding="{Binding Definition.Module}" Width="70"/>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="地址" Binding="{Binding Definition.Address}" Width="145"/>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="中文说明" Binding="{Binding Description}" Width="*" MinWidth="200"/>
 <DataGridTemplateColumn Header="当前值" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <Ellipse Width="16" Height="16" Fill="{Binding LightColor}" Stroke="#64748B" Margin="8,0,10,0"/>
   <TextBlock Text="{Binding ValueText}"/>
  </StackPanel>
 </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="质量" Binding="{Binding QualityText}" Width="105"/>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="更新时间" Binding="{Binding UpdatedAtText}" Width="125"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="2,12,0,0" Foreground="#527087" TextWrapping="Wrap" FontSize="15"/>
    </Grid>
   </Border>
  </controls:HmiPageLayout.PageContent>
 </controls:HmiPageLayout>
</Page>

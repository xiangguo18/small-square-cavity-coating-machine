<Window x:Class="Small_square_cavity_coating_machine.Views.NewRecipeLayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建配方层"
        Width="650"
        Height="760"
        MinWidth="580"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#EEF2F5">
    <Window.Resources>
        <DataTemplate x:Key="ParameterInputTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="15"
                           Text="{Binding Label}"/>
                <TextBox Grid.Column="1"
                         Height="32"
                         Padding="8,4"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="2"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#526777"
                           Text="{Binding Unit}"/>
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="#C45A00"
                           FontSize="12"
                           Text="{Binding Hint}"
                           TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="GroupBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CDD9E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,4,14">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#1F2D3D"
                       Text="新建配方层"/>
            <TextBlock Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="#526777"
                       Text="{Binding Sequence, StringFormat=序号：{0}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2">
                <Border Style="{StaticResource GroupBorderStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1D5D88"
                                   Text="功率、时间与运动"/>
                        <ItemsControl ItemsSource="{Binding PowerAndTimeInputs}"
                                      ItemTemplate="{StaticResource ParameterInputTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GroupBorderStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1D5D88"
                                   Text="工艺气体"/>
                        <ItemsControl ItemsSource="{Binding GasInputs}"
                                      ItemTemplate="{StaticResource ParameterInputTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GroupBorderStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1D5D88"
                                   Text="气压与 APC"/>
                        <ItemsControl ItemsSource="{Binding PressureAndApcInputs}"
                                      ItemTemplate="{StaticResource ParameterInputTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="取消"/>
            <Button Width="112"
                    Height="38"
                    Background="#0078D4"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click"
                    Content="生成配方层"/>
        </StackPanel>
    </Grid>
</Window>

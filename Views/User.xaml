<Page x:Class="Small_square_cavity_coating_machine.Views.User"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
      mc:Ignorable="d"
      d:DesignHeight="750"
      d:DesignWidth="1120"
      Background="#EEF2F5"
      Title="User">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <controls:ByteArrayToImageSourceConverter x:Key="AvatarConverter"/>

        <Style x:Key="UserActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Background" Value="#F7FBFE"/>
            <Setter Property="BorderBrush" Value="#2D8FCC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#165F8D"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5F3FC"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UserListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="BorderBrush" Value="#D6E0E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF4FB"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8CBFDF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#DCEEFF"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#284456"/>
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="BorderBrush" Value="#C9D7E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="PermissionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBorder"
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="White"
                                        BorderBrush="#7F98AA"
                                        BorderThickness="1.5"
                                        CornerRadius="3">
                                    <TextBlock x:Name="CheckMark"
                                               Text="✓"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PermissionBorder" Property="Background" Value="#E5F3FC"/>
                                <Setter TargetName="PermissionBorder" Property="BorderBrush" Value="#2D8FCC"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#1686C5"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#1686C5"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PermissionBorder" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <controls:HmiPageLayout PageTitle="用户权限">
        <controls:HmiPageLayout.PageContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        Background="White"
                        BorderBrush="#D3DDE5"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新建"
                                    Style="{StaticResource UserActionButtonStyle}"
                                    Command="{Binding NewUserCommand}"/>
                            <Button Content="保存"
                                    Style="{StaticResource UserActionButtonStyle}"
                                    Command="{Binding SaveCommand}"/>
                            <Button Content="删除"
                                    Style="{StaticResource UserActionButtonStyle}"
                                    Command="{Binding DeleteCommand}"/>
                            <Button Content="{Binding MaintenanceInterlockButtonText}"
                                    Style="{StaticResource UserActionButtonStyle}"
                                    Command="{Binding ToggleMaintenanceInterlockCommand}"
                                    IsEnabled="{Binding CanToggleMaintenanceInterlock}"
                                    BorderBrush="#FF3B30" BorderThickness="2"
                                    ToolTip="仅当前登录的内置管理员slkj可解除或恢复PLC互锁"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="12,7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EFF8EF"/>
                                    <Setter Property="BorderBrush" Value="#A8D2AA"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Background" Value="#FFF1F0"/>
                                            <Setter Property="BorderBrush" Value="#E0AAA6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#32753A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Foreground" Value="#B42318"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="285"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Padding="14"
                            Background="White"
                            BorderBrush="#D3DDE5"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Margin="2,0,0,12"
                                       Text="已有用户"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2D3D"/>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Users}"
                                     SelectedItem="{Binding SelectedUser, Mode=OneWay}"
                                     SelectionChanged="UserList_SelectionChanged"
                                     ItemContainerStyle="{StaticResource UserListItemStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="34" Height="34">
                                                <Ellipse Fill="#DCEEFF"
                                                         Stroke="#8BBEDC"
                                                         StrokeThickness="1"/>
                                                <TextBlock Text="&#xF007;"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                                           FontSize="17"
                                                           Foreground="#1775A8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AvatarData}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image Source="{Binding AvatarData, Converter={StaticResource AvatarConverter}}"
                                                       Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="17,17" RadiusX="16" RadiusY="16"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserName}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="#203846"/>
                                                <TextBlock Text="内置管理员"
                                                           Margin="0,2,0,0"
                                                           FontSize="12"
                                                           Foreground="#C06A10"
                                                           Visibility="{Binding IsBuiltInAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="White"
                            BorderBrush="#D3DDE5"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="用户名"
                                               Margin="0,0,0,7"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#405A6A"/>
                                    <TextBox Height="42"
                                             Padding="10,7"
                                             VerticalContentAlignment="Center"
                                             FontSize="17"
                                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsUserNameReadOnly}"
                                             PreviewMouseDown="UserNameInput_PreviewMouseDown"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="密码（留空表示不修改密码）"
                                               Margin="0,0,0,7"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#405A6A"/>
                                    <PasswordBox Height="42"
                                                 Padding="10,7"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="17"
                                                 Focusable="{Binding CanEditPassword}"
                                                 IsTabStop="{Binding CanEditPassword}"
                                                 PreviewMouseDown="PasswordInput_PreviewMouseDown"
                                                 PasswordChanged="PasswordInput_PasswordChanged"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="10"
                                    Background="#F9FBFC"
                                    BorderBrush="#D9E3EA"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="8,2,8,6"
                                                Orientation="Horizontal">
                                        <TextBlock Text="开通权限"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2D3D"/>
                                        <TextBlock Margin="12,5,0,0"
                                                   Text="无权限仍可进入页面查看，但不能执行操作"
                                                   FontSize="13"
                                                   Foreground="#647C8C"/>
                                    </StackPanel>
                                    <ItemsControl Grid.Row="1"
                                                  ItemsSource="{Binding PermissionOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" Rows="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                                          Focusable="{Binding DataContext.CanEditPermissions, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                          IsTabStop="{Binding DataContext.CanEditPermissions, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                          PreviewMouseDown="PermissionCheckBox_PreviewMouseDown"
                                                          Style="{StaticResource PermissionCheckBoxStyle}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </controls:HmiPageLayout.PageContent>
    </controls:HmiPageLayout>
</Page>

<Window x:Class="Small_square_cavity_coating_machine.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户登录"
        Width="460"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F5"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1686C5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0871AE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Border Padding="28,22"
                Background="White"
                BorderBrush="#D3DDE5"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center">
                    <Border Width="64" Height="64"
                            Background="#DCEEFF"
                            CornerRadius="32">
                        <TextBlock Text="&#xF2BD;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                   FontSize="34"
                                   Foreground="#1686C5"/>
                    </Border>
                    <TextBlock Margin="0,10,0,18"
                               Text="用户登录"
                               HorizontalAlignment="Center"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#1F2D3D"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Margin="0,0,0,6"
                               Text="用户名"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#405A6A"/>
                    <TextBox x:Name="UserNameInput"
                             Height="42"
                             Padding="10,7"
                             VerticalContentAlignment="Center"
                             FontSize="17"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="0,0,0,6"
                               Text="密码"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#405A6A"/>
                    <PasswordBox x:Name="PasswordInput"
                                 Height="42"
                                 Padding="10,7"
                                 VerticalContentAlignment="Center"
                                 FontSize="17"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Grid.Row="3"
                           MinHeight="24"
                           Margin="0,8,0,4"
                           TextAlignment="Center"
                           FontSize="14"
                           Foreground="#B42318"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Width="112"
                            Height="44"
                            Margin="0,0,12,0"
                            Content="取消"
                            FontSize="17"
                            IsCancel="True"/>
                    <Button Content="登录"
                            IsDefault="True"
                            Style="{StaticResource LoginButtonStyle}"
                            Click="LoginButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

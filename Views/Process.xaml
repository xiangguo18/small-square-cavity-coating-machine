<Page x:Class="Small_square_cavity_coating_machine.Views.Process"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
      mc:Ignorable="d"
      d:DesignHeight="750"
      d:DesignWidth="1120"
      Background="#EEF2F5"
      Title="Process">
    <Page.Resources>
        <Style x:Key="RecipeActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="122"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="#F7FBFE"/>
            <Setter Property="BorderBrush" Value="#2D8FCC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#165F8D"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5F3FC"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#DCECF7"/>
            <Setter Property="Foreground" Value="#173B52"/>
            <Setter Property="BorderBrush" Value="#AEC6D6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RecipeGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D8E1E7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="RecipeGridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#243746"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F7FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE8FA"/>
                    <Setter Property="Foreground" Value="#123C5A"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#FFE08A"/>
                    <Setter Property="Foreground" Value="#5B3A00"/>
                    <Setter Property="BorderBrush" Value="#F39C12"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <controls:HmiPageLayout PageTitle="工艺配方">
        <controls:HmiPageLayout.PageContent>
            <Border Background="White"
                    BorderBrush="#D3DDE5"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RecipeActionButtonStyle}"
                                    Command="{Binding ImportRecipeCommand}"
                                    Content="导入配方"/>
                            <Button Style="{StaticResource RecipeActionButtonStyle}"
                                    Command="{Binding ClearRecipeCommand}"
                                    Content="清除配方"/>
                            <Button Style="{StaticResource RecipeActionButtonStyle}"
                                    Command="{Binding NewRecipeLayerCommand}"
                                    Content="新建配方层"/>
                            <Button Style="{StaticResource RecipeActionButtonStyle}"
                                    Command="{Binding SendAllCommand}"
                                    Content="下发所有层"/>
                            <Button Style="{StaticResource RecipeActionButtonStyle}"
                                    Command="{Binding SendSelectedCommand}"
                                    Content="下发选中层"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="#587181"
                                       FontSize="13"
                                       Text="{Binding LoadedFileName, StringFormat=当前文件：{0}}"/>
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="#587181"
                                       FontSize="13"
                                       Text="{Binding Layers.Count, StringFormat=配方层数：{0}}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Layers}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              AlternationCount="2"
                              FrozenColumnCount="1"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              ColumnHeaderStyle="{StaticResource RecipeGridHeaderStyle}"
                              CellStyle="{StaticResource RecipeGridCellStyle}"
                              RowStyle="{StaticResource RecipeGridRowStyle}"
                              BorderBrush="#AEC6D6"
                              BorderThickness="1"
                              Background="White"
                              FontSize="13"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="RecipeGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号"
                                                Width="0.62*"
                                                Binding="{Binding Sequence}"/>
                            <DataGridTextColumn Header="阴极A功率&#x0a;(W)"
                                                Width="1.05*"
                                                Binding="{Binding CathodeAPower, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="阴极B功率&#x0a;(W)"
                                                Width="1.05*"
                                                Binding="{Binding CathodeBPower, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="功率跨度&#x0a;(W)"
                                                Width="0.95*"
                                                Binding="{Binding PowerSpan, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="间隔时间&#x0a;(s)"
                                                Width="0.92*"
                                                Binding="{Binding IntervalSeconds, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="预溅射时间&#x0a;(s)"
                                                Width="1.02*"
                                                Binding="{Binding PreSputterSeconds, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="样品台转速&#x0a;(rpm)"
                                                Width="1.08*"
                                                Binding="{Binding StageSpeedRpm, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="镀膜时间&#x0a;(s)"
                                                Width="0.92*"
                                                Binding="{Binding CoatingSeconds, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="启辉Ar&#x0a;(Sccm)"
                                                Width="0.9*"
                                                Binding="{Binding IgnitionArgonSccm, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="工作Ar&#x0a;(Sccm)"
                                                Width="0.9*"
                                                Binding="{Binding WorkingArgonSccm, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="启辉N₂&#x0a;(Sccm)"
                                                Width="0.9*"
                                                Binding="{Binding IgnitionNitrogenSccm, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="工作N₂&#x0a;(Sccm)"
                                                Width="0.9*"
                                                Binding="{Binding WorkingNitrogenSccm, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="启辉O₂&#x0a;(Sccm)"
                                                Width="0.9*"
                                                Binding="{Binding IgnitionOxygenSccm, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="工作O₂&#x0a;(Sccm)"
                                                Width="0.9*"
                                                Binding="{Binding WorkingOxygenSccm, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="气流稳定时间&#x0a;(s)"
                                                Width="1.12*"
                                                Binding="{Binding GasStabilizationSeconds, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="启辉气压&#x0a;(Pa)"
                                                Width="0.9*"
                                                Binding="{Binding IgnitionPressurePa, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="工作气压&#x0a;(Pa)"
                                                Width="0.9*"
                                                Binding="{Binding WorkingPressurePa, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="启辉APC&#x0a;(%)"
                                                Width="0.88*"
                                                Binding="{Binding IgnitionApcPercent, StringFormat=0.###}"/>
                            <DataGridTextColumn Header="工作APC&#x0a;(%)"
                                                Width="0.88*"
                                                Binding="{Binding WorkingApcPercent, StringFormat=0.###}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </controls:HmiPageLayout.PageContent>
    </controls:HmiPageLayout>
</Page>

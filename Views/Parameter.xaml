<Page x:Class="Small_square_cavity_coating_machine.Views.Parameter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
 Background="#EEF2F5" Title="参数设置">
 <Page.Resources>
  <Style x:Key="EquipmentCellText" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E7F2FC"/><Setter Property="Foreground" Value="#20364C"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Page.Resources>
 <controls:HmiPageLayout PageTitle="参数设置">
  <controls:HmiPageLayout.PageContent>
   <Border Background="White" BorderBrush="#D3DDE5" BorderThickness="1" CornerRadius="8" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Enter 提交当前项 · Esc 取消编辑 · 离开输入框不写入 · 回读确认仅代表 PLC 变量值" Foreground="#527087" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button Content="分子泵低速" Command="{Binding TurboLowSpeedCommand}" Padding="18,8" Margin="8,0,0,0"/>
       <Button Content="分子泵复位" Command="{Binding TurboResetCommand}" Padding="18,8" Margin="8,0,0,0"/>
       <TextBlock Text="{Binding TurboCommandStatus}" Foreground="#527087" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
     </Grid>
     <DataGrid Grid.Row="1" FontSize="16" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E8EF"
      AlternatingRowBackground="#F5F8FC" Background="White" BorderBrush="#D3DDE5" RowHeight="64"
      SelectionMode="Single" EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
 <DataGridTemplateColumn Header="中文参数名" Width="2*" MinWidth="230"><DataGridTemplateColumn.CellTemplate><DataTemplate>
  <TextBlock Style="{StaticResource EquipmentCellText}" Text="{Binding Name}" ToolTip="{Binding Details}" TextWrapping="Wrap" Margin="8,0"/>
 </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="PLC当前值" Width="1.6*" MinWidth="185"><DataGridTemplateColumn.CellTemplate><DataTemplate>
  <StackPanel VerticalAlignment="Center" Margin="8,0">
   <TextBlock Text="{Binding CurrentText}" FontWeight="SemiBold" Foreground="#173F65"/>
   <TextBlock Text="{Binding ReferenceText}" FontSize="12" Foreground="#6D7F90" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReferenceText}"/>
  </StackPanel>
 </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="设定值（Enter提交）" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate>
  <TextBox Text="{Binding DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditorReadOnly}"
   ToolTip="{Binding AvailabilityText}" FontSize="17" Padding="7,4" Margin="6,8" VerticalContentAlignment="Center"
   controls:ParameterEditorBehavior.Enabled="True" controls:ParameterEditorBehavior.SubmitCommand="{Binding SubmitCommand}"
   controls:ParameterEditorBehavior.CancelCommand="{Binding CancelEditCommand}" controls:ParameterEditorBehavior.BeginCommand="{Binding BeginEditCommand}"
   controls:ParameterEditorBehavior.EndCommand="{Binding EndEditCommand}">
   <TextBox.Style><Style TargetType="TextBox"><Setter Property="Background" Value="#F0F7FF"/>
    <Style.Triggers><Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="#F1F2F4"/><Setter Property="Foreground" Value="#677687"/></Trigger>
    <DataTrigger Binding="{Binding HasDraft}" Value="True"><Setter Property="BorderBrush" Value="#0087DE"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers>
   </Style></TextBox.Style>
  </TextBox>
 </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="单位" Binding="{Binding Definition.Unit}" Width="80"/>
 <DataGridTextColumn ElementStyle="{StaticResource EquipmentCellText}" Header="允许范围" Binding="{Binding RangeText}" Width="120"/>
 <DataGridTemplateColumn Header="写入状态" Width="2*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate>
  <StackPanel VerticalAlignment="Center" Margin="8,0">
   <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
   <TextBlock Text="{Binding AvailabilityText}" FontSize="13" Foreground="#6D7F90"/>
  </StackPanel>
 </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="2" Text="阀门动作时间（只读）" Margin="2,10,0,6" FontSize="17" FontWeight="SemiBold" Foreground="#20364C"/>
     <DataGrid Grid.Row="3" ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False" IsReadOnly="True"
      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
      HorizontalGridLinesBrush="#E1E8EF" AlternatingRowBackground="#F5F8FC" RowHeight="34">
      <DataGrid.Columns>
       <DataGridTextColumn Header="参数" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="PLC地址" Binding="{Binding Address}" Width="2*"/>
       <DataGridTextColumn Header="当前值" Binding="{Binding ValueText}" Width="*"/>
       <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80"/>
       <DataGridTextColumn Header="质量" Binding="{Binding QualityText}" Width="110"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="2,12,0,0" Foreground="#527087" TextWrapping="Wrap" FontSize="15"/>
    </Grid>
   </Border>
  </controls:HmiPageLayout.PageContent>
 </controls:HmiPageLayout>
</Page>

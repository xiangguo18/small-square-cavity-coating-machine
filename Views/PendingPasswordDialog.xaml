<Window x:Class="Small_square_cavity_coating_machine.Views.PendingPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码尚未保存"
        Width="470"
        Height="230"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F5">
    <Border Margin="18"
            Padding="22"
            Background="White"
            BorderBrush="#D3DDE5"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="MessageText"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="#1F2D3D"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <StackPanel Grid.Row="1"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Width="105" Height="38" Margin="0,0,10,0"
                        Content="修改"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#1686C5"
                        BorderBrush="#0871AE"
                        Click="SaveButton_Click"/>
                <Button Width="105" Height="38" Margin="0,0,10,0"
                        Content="不修改"
                        FontSize="15"
                        Click="DiscardButton_Click"/>
                <Button Width="105" Height="38"
                        Content="取消"
                        FontSize="15"
                        IsDefault="True"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="Small_square_cavity_coating_machine.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Small_square_cavity_coating_machine.Views"
        mc:Ignorable="d"
        Title="小方腔体磁控溅射镀膜机" Height="750" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="gridMenu1" Grid.Column="0" Width="80" Background="LightBlue">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <!-- Logo -->
            <StackPanel Background="LightBlue" Orientation="Horizontal">
                <Image Source="/Resources/logo.png" 
                       Width="60" Height="60" 
                       Margin="10 0 0 0" 
                       VerticalAlignment="Center" 
                       Stretch="Uniform"></Image>
                <Image Source="/Resources/title.png" 
                       Margin="20 0 0 0" 
                       VerticalAlignment="Center" 
                       Stretch="Uniform"></Image>
            </StackPanel>


            <!-- 折叠状态栏按钮 -->
            <ToggleButton Grid.Row="1" 
                          Content="&#xF039;" 
                          FontSize="30" 
                          FontFamily="Font Awesome 5 Free Solid" 
                          Background="LightBlue"
                          BorderThickness="0"
                          BorderBrush="Transparent">
                <ToggleButton.Triggers>
                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                        <BeginStoryboard>
                            <Storyboard x:Name="closeMenu">
                                <DoubleAnimation Storyboard.TargetName="gridMenu1" 
                                                 Storyboard.TargetProperty="Width" From="260" To="80"
                                                 Duration="0:0:0.5">
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                        <BeginStoryboard>
                            <Storyboard x:Name="showMenu">
                                <DoubleAnimation Storyboard.TargetName="gridMenu1" 
                                                 Storyboard.TargetProperty="Width" From="60" To="260"
                                                 Duration="0:0:0.5">
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ToggleButton.Triggers>   
            </ToggleButton>

            <!-- 功能菜单栏 -->
            <StackPanel Grid.Row="2" Background="lightBlue">
               
                <!-- 1 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch" Style="{StaticResource sty1}" Click="IOButton_Click">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <!-- 图标列中心线对齐 -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- 文字列中心线对齐 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <TextBlock 
                                           Grid.Column="0"
                                           Text="&#xF2DB;"
                                           FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                           FontSize="35"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock 
                                           Grid.Column="1"
                                           Text="I/O状态"
                                           FontSize="35"
                                           Margin="25,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>

                <!-- 2 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch" Style="{StaticResource sty1}" Click="ParameterButton_Click">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <!-- 图标列中心线对齐 -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- 文字列中心线对齐 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <TextBlock 
                                           Grid.Column="0"
                                           Text="&#xF013;"
                                           FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                           FontSize="35"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock 
                                           Grid.Column="1"
                                           Text="参数设置"
                                           FontSize="35"
                                           Margin="25,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>

                <!-- 3 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch" Style="{StaticResource sty1}" Click="SystemButton_Click">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <!-- 图标列中心线对齐 -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- 文字列中心线对齐 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <TextBlock 
                                           Grid.Column="0"
                                           Text="&#xF3FD;"
                                           FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                           FontSize="35"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock 
                                           Grid.Column="1"
                                           Text="系统状态"
                                           FontSize="35"
                                           Margin="25,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>

                <!-- 4 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch" Style="{StaticResource sty1}" Click="ProcessButton_Click">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <!-- 图标列中心线对齐 -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- 文字列中心线对齐 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <TextBlock 
                                           Grid.Column="0"
                                           Text="&#xF0AE;"
                                           FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                           FontSize="35"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock 
                                           Grid.Column="1"
                                           Text="工艺配方"
                                           FontSize="35"
                                           Margin="25,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>
                
                <!-- 5 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch" Style="{StaticResource sty1}" Click="HistoryButton_Click">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <!-- 图标列中心线对齐 -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- 文字列中心线对齐 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <TextBlock 
                                            Grid.Column="0"
                                            Text="&#xF073;"
                                            FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                            FontSize="35"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock 
                                           Grid.Column="1"
                                           Text="历史记录"
                                           FontSize="35"
                                           Margin="25,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>

                <!-- 6 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch" Style="{StaticResource sty1}" Click="UserButton_Click">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <!-- 图标列中心线对齐 -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- 文字列中心线对齐 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <TextBlock 
                                           Grid.Column="0"
                                           Text="&#xF084;"
                                           FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                           FontSize="35"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock 
                                           Grid.Column="1"
                                           Text="用户权限"
                                           FontSize="35"
                                           Margin="25,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>

            </StackPanel>


        </Grid>

        <Frame Grid.Column="1" x:Name="PageNavigation" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>

<Window x:Class="Small_square_cavity_coating_machine.Views.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
        Title="个人资料"
        Width="570"
        Height="690"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F5">
    <Window.Resources>
        <controls:ByteArrayToImageSourceConverter x:Key="AvatarConverter"/>
        <Style x:Key="ProfileActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Background" Value="#F7FBFE"/>
            <Setter Property="BorderBrush" Value="#2D8FCC"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Foreground" Value="#165F8D"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Padding="24"
                Background="White"
                BorderBrush="#D3DDE5"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="个人资料"
                           HorizontalAlignment="Center"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#1F2D3D"/>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="112" Height="112">
                        <Ellipse Fill="#DCEEFF"
                                 Stroke="#8BBEDC"
                                 StrokeThickness="2"/>
                        <TextBlock x:Name="DefaultAvatarIcon"
                                   Text="&#xF007;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                   FontSize="48"
                                   Foreground="#1686C5"/>
                        <Image x:Name="AvatarPreview"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="56,56" RadiusX="54" RadiusY="54"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}"
                                   Margin="0,0,0,12"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#203846"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="选择头像"
                                    Style="{StaticResource ProfileActionButtonStyle}"
                                    Click="ChooseAvatarButton_Click"/>
                            <Button Content="使用默认头像"
                                    Style="{StaticResource ProfileActionButtonStyle}"
                                    Click="ClearAvatarButton_Click"/>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Text="支持 PNG、JPG、BMP；也可以不选择头像"
                                   FontSize="12"
                                   Foreground="#6D8391"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3"
                        Padding="18"
                        Background="#F9FBFC"
                        BorderBrush="#D9E3EA"
                        BorderThickness="1"
                        CornerRadius="7">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,13"
                                   Text="修改密码（不修改可全部留空）"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2D3D"/>
                        <TextBlock Margin="0,0,0,5" Text="原密码" Foreground="#405A6A"/>
                        <PasswordBox x:Name="CurrentPasswordInput"
                                     Height="39" Padding="9,6" FontSize="16"/>
                        <TextBlock Margin="0,11,0,5" Text="新密码" Foreground="#405A6A"/>
                        <PasswordBox x:Name="NewPasswordInput"
                                     Height="39" Padding="9,6" FontSize="16"/>
                        <TextBlock Margin="0,11,0,5" Text="确认新密码" Foreground="#405A6A"/>
                        <PasswordBox x:Name="ConfirmPasswordInput"
                                     Height="39" Padding="9,6" FontSize="16"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Grid.Row="4"
                           MinHeight="28"
                           Margin="0,10,0,4"
                           TextAlignment="Center"
                           FontSize="14"
                           Foreground="#B42318"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Width="110" Height="42" Margin="0,0,12,0"
                            Content="取消" FontSize="16" IsCancel="True"/>
                    <Button Width="126" Height="42"
                            Content="保存资料"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#1686C5"
                            BorderBrush="#0871AE"
                            IsDefault="True"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

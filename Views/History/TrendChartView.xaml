<UserControl x:Class="Small_square_cavity_coating_machine.Views.HistoryModules.TrendChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             d:DesignHeight="580"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <DataTemplate x:Key="TrendStatusTemplate">
            <StackPanel Margin="8,5,8,3">
                <TextBlock Text="{Binding CurrentFileName}"
                           FontWeight="SemiBold"
                           Foreground="#334A5F"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,2,0,0"
                           Foreground="#607D8B"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8,4,8,8">
        <TabControl Style="{StaticResource TrendTabControlStyle}"
                    ItemContainerStyle="{StaticResource TrendTabItemStyle}">
            <TabItem Header="真空度">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource TrendStatusTemplate}"/>
                    <StackPanel Grid.Row="1"
                                Margin="8,4,8,7"
                                Orientation="Horizontal">
                        <CheckBox Margin="0,0,22,0"
                                  Content="高真空度计"
                                  IsChecked="{Binding ShowHighVacuum}"/>
                        <CheckBox Content="薄膜高真空度计"
                                  IsChecked="{Binding ShowFilmHighVacuum}"/>
                    </StackPanel>
                    <oxy:PlotView Grid.Row="2"
                                  Model="{Binding VacuumPlotModel}"/>
                </Grid>
            </TabItem>

            <TabItem Header="电源">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource TrendStatusTemplate}"/>
                    <StackPanel Grid.Row="1"
                                Margin="8,4,8,7"
                                Orientation="Horizontal">
                        <CheckBox Margin="0,0,22,0"
                                  Content="电源1电压"
                                  IsChecked="{Binding ShowPower1Voltage}"/>
                        <CheckBox Margin="0,0,22,0"
                                  Content="电源1电流"
                                  IsChecked="{Binding ShowPower1Current}"/>
                        <CheckBox Margin="0,0,22,0"
                                  Content="电源2电压"
                                  IsChecked="{Binding ShowPower2Voltage}"/>
                        <CheckBox Content="电源2电流"
                                  IsChecked="{Binding ShowPower2Current}"/>
                    </StackPanel>
                    <oxy:PlotView Grid.Row="2"
                                  Model="{Binding PowerPlotModel}"/>
                </Grid>
            </TabItem>

            <TabItem Header="温度">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource TrendStatusTemplate}"/>
                    <CheckBox Grid.Row="1"
                              Margin="8,4,8,7"
                              Content="温度"
                              IsChecked="{Binding ShowTemperature}"/>
                    <oxy:PlotView Grid.Row="2"
                                  Model="{Binding TemperaturePlotModel}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Padding="10,4"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                Background="#FFF4D6"
                BorderBrush="#E7BA4F"
                BorderThickness="1"
                CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="模拟数据模式"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#8A5800"/>
        </Border>

        <Button MinWidth="100"
                Height="34"
                Padding="18,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                Content="{Binding ActionText}"
                Command="{Binding ActionCommand}"
                FontSize="15"
                FontWeight="SemiBold"/>
    </Grid>
</UserControl>

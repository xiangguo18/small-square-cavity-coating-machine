<UserControl x:Class="Small_square_cavity_coating_machine.Views.HistoryModules.TrendChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             d:DesignHeight="580"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="TrendLegendLineStyle" TargetType="Line">
            <Setter Property="X1" Value="0"/>
            <Setter Property="X2" Value="40"/>
            <Setter Property="Y1" Value="6"/>
            <Setter Property="Y2" Value="6"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="Margin" Value="6,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TrendLegendCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,22,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TrendOptionalStatusStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TrendStatusTemplate">
            <StackPanel Margin="8,5,8,3">
                <TextBlock Text="{Binding AcquisitionStatus}" Foreground="#607D8B" Style="{StaticResource TrendOptionalStatusStyle}"/>
                <TextBlock Text="{Binding RecordingError}" Foreground="#C62828" Style="{StaticResource TrendOptionalStatusStyle}"/>
                <TextBlock Text="{Binding CurrentFileName}"
                           FontWeight="SemiBold"
                           Foreground="#334A5F"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,2,0,0"
                           Foreground="#607D8B"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8,4,8,8">
        <TabControl Style="{StaticResource TrendTabControlStyle}"
                    ItemContainerStyle="{StaticResource TrendTabItemStyle}"
                    SelectedIndex="{Binding SelectedChartIndex, Mode=TwoWay}">
            <TabItem Header="真空度">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource TrendStatusTemplate}"/>
                    <WrapPanel Grid.Row="1"
                                Margin="8,4,8,7"
                                Orientation="Horizontal">
                        <CheckBox Style="{StaticResource TrendLegendCheckBoxStyle}"
                                  AutomationProperties.Name="高真空度计"
                                  IsChecked="{Binding ShowHighVacuum}">
                            <StackPanel Orientation="Horizontal">
                                <Line Style="{StaticResource TrendLegendLineStyle}" Stroke="Red"/>
                                <TextBlock Text="高真空度计"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TrendLegendCheckBoxStyle}"
                                  AutomationProperties.Name="薄膜高真空度计"
                                  IsChecked="{Binding ShowFilmHighVacuum}">
                            <StackPanel Orientation="Horizontal">
                                <Line Style="{StaticResource TrendLegendLineStyle}" Stroke="Blue"/>
                                <TextBlock Text="薄膜高真空度计"/>
                            </StackPanel>
                        </CheckBox>
                    </WrapPanel>
                    <oxy:PlotView Grid.Row="2"
                                  Model="{Binding VacuumPlotModel}"/>
                </Grid>
            </TabItem>

            <TabItem Header="电源">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource TrendStatusTemplate}"/>
                    <WrapPanel Grid.Row="1"
                                Margin="8,4,8,7"
                                Orientation="Horizontal">
                        <CheckBox Style="{StaticResource TrendLegendCheckBoxStyle}"
                                  AutomationProperties.Name="电源1电压"
                                  IsChecked="{Binding ShowPower1Voltage}">
                            <StackPanel Orientation="Horizontal">
                                <Line Style="{StaticResource TrendLegendLineStyle}" Stroke="Red"/>
                                <TextBlock Text="电源1电压"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TrendLegendCheckBoxStyle}"
                                  AutomationProperties.Name="电源1电流"
                                  IsChecked="{Binding ShowPower1Current}">
                            <StackPanel Orientation="Horizontal">
                                <Line Style="{StaticResource TrendLegendLineStyle}" Stroke="Red" StrokeDashArray="4,1"/>
                                <TextBlock Text="电源1电流"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TrendLegendCheckBoxStyle}"
                                  AutomationProperties.Name="电源2电压"
                                  IsChecked="{Binding ShowPower2Voltage}">
                            <StackPanel Orientation="Horizontal">
                                <Line Style="{StaticResource TrendLegendLineStyle}" Stroke="Blue"/>
                                <TextBlock Text="电源2电压"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TrendLegendCheckBoxStyle}"
                                  AutomationProperties.Name="电源2电流"
                                  IsChecked="{Binding ShowPower2Current}">
                            <StackPanel Orientation="Horizontal">
                                <Line Style="{StaticResource TrendLegendLineStyle}" Stroke="Blue" StrokeDashArray="4,1"/>
                                <TextBlock Text="电源2电流"/>
                            </StackPanel>
                        </CheckBox>
                    </WrapPanel>
                    <oxy:PlotView Grid.Row="2"
                                  Model="{Binding PowerPlotModel}"/>
                </Grid>
            </TabItem>

            <TabItem Header="温度">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource TrendStatusTemplate}"/>
                    <CheckBox Grid.Row="1"
                              Margin="8,4,8,7"
                              Style="{StaticResource TrendLegendCheckBoxStyle}"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="温度"
                              IsChecked="{Binding ShowTemperature}">
                        <StackPanel Orientation="Horizontal">
                            <Line Style="{StaticResource TrendLegendLineStyle}" Stroke="Red"/>
                            <TextBlock Text="温度"/>
                        </StackPanel>
                    </CheckBox>
                    <oxy:PlotView Grid.Row="2"
                                  Model="{Binding TemperaturePlotModel}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Padding="10,4"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                Background="#FFF4D6"
                BorderBrush="#E7BA4F"
                BorderThickness="1"
                CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="模拟数据模式（每1秒记录）"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#8A5800"/>
        </Border>

        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Panel.ZIndex="2">
            <Button MinWidth="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Padding="18,4"
                    Content="刷新"
                    Command="{Binding RefreshCurrentChartCommand}"
                    FontSize="15"
                    FontWeight="SemiBold">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutomaticDisplayAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button MinWidth="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Padding="18,4"
                    Content="自动化显示"
                    Command="{Binding ResumeLiveFollowCommand}"
                    FontSize="15"
                    FontWeight="SemiBold">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutomaticDisplayAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button MinWidth="100"
                    Height="34"
                    Padding="18,4"
                    Content="{Binding ActionText}"
                    Command="{Binding ActionCommand}"
                    FontSize="15"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>

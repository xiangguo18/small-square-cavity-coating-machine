                                                <TextBlock Text="样品挡板"
                                                   Margin="0,0,0,8"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2D3D"
                                                   TextAlignment="Center"/>
                                                <controls:ShutterSwitchButton Width="120"
                                                                      Height="45"
                                                                      HorizontalAlignment="Center"
                                                                      DeviceName="挡板"
                                                                      IsOn="{Binding SampleShutterIsOn}"
                                                                      IsInterlockReleased="{Binding SampleShutterInterlockReleased}"
                                                                      Command="{Binding ToggleSampleShutterCommand}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                        Padding="8"
                                        Background="#F8FAFC"
                                        BorderBrush="#AEBCC8"
                                        BorderThickness="1.5"
                                        CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock Text="靶1挡板"
                                                   Margin="0,0,0,8"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2D3D"
                                                   TextAlignment="Center"/>
                                                <controls:ShutterSwitchButton Width="120"
                                                                      Height="45"
                                                                      HorizontalAlignment="Center"
                                                                      DeviceName="挡板"
                                                                      IsOn="{Binding Target1ShutterIsOn}"

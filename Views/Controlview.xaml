<Page x:Class="Small_square_cavity_coating_machine.Views.Controlview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
      xmlns:viewModels="clr-namespace:Small_square_cavity_coating_machine.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="750"
      d:DesignWidth="1120"
      Background="#EEF2F5"
      Title="系统状态">

    <Page.DataContext>
        <viewModels:ControlViewModel/>
    </Page.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="系统状态"
                               FontSize="50"
                               FontWeight="SemiBold"
                               Foreground="#1F2D3D"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                <Ellipse Width="13" Height="13"
                             Fill="#20D34A"
                             Stroke="#263238"
                             StrokeThickness="1.5"/>
                <TextBlock Text="互锁已解除"
                               Margin="7,0,18,0"
                               VerticalAlignment="Center"/>
                <Ellipse Width="13" Height="13"
                             Fill="White"
                             Stroke="#263238"
                             StrokeThickness="1.5"/>
                <TextBlock Text="互锁未解除"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                    Padding="12"
                    Background="White"
                    BorderBrush="#D6DEE5"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
            <Viewbox Stretch="Uniform"
                         StretchDirection="Both" Margin="-3,-17,3,16">
                <!-- 更宽的逻辑缩放区域使菜单宽度变化在最大化状态下仍能驱动等比例缩放；
                         实际设备画布保持 1020×560 并靠左。 -->
                <Grid Width="1440" Height="560">
                    <Canvas Width="1020"
                                Height="560"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                        <!-- 腔体与真空度计 -->
                        <!-- 腔体与真空度计 -->
                        <Rectangle Canvas.Left="77" Canvas.Top="114"
                               Width="216" Height="244"
                               RadiusX="12" RadiusY="12"
                               Fill="#F7F8FA"
                               Stroke="#34495E"
                               StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <TextBlock Canvas.Left="103" Canvas.Top="220"
                               Width="164"
                               Text="真空腔体"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                        <!-- 腔体右侧：横管、横阀、弯头和干泵 -->
                        <controls:ValveControl
                        Canvas.Left="347" Canvas.Top="226"
                        Width="111" Height="100"
                        DeviceName="旁抽阀"
                        Orientation="Horizontal"
                        IsOpen="{Binding BranchValveIsOpen}"
                        IsInterlockReleased="{Binding BranchValveInterlockReleased}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- MFC 三行显示 -->
                        <controls:MfcFlowMeterControl
                        Canvas.Left="280" Canvas.Top="436"
                        Width="170" Height="72"
                        DisplayName="MFC · O2"
                        CurrentFlow="{Binding ArgonCurrentFlow}"
                        SetpointFlow="{Binding ArgonSetpointFlow}"
                        Unit="sccm"
                        ValueFormat="0.0"/>

                        <!-- 直管 + 两个弯头拼成连续的U形管路 -->
                        <controls:StraightPipeControl
                        Canvas.Left="293" Canvas.Top="253"
                        Width="82" Height="24"
                        IsFlowing="{Binding VacuumPathIsFlowing}"
                        FlowAnimationDirection="Forward" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <!-- 四种弯头方向，用于在设计器中复制 -->
                        <controls:ValveControl
                        Canvas.Left="347" Canvas.Top="133"
                        Width="111" Height="100"
                        DeviceName="APC阀"
                        Orientation="Horizontal"
                        IsOpen="{Binding BranchValveIsOpen}"
                        IsInterlockReleased="{Binding BranchValveInterlockReleased}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <controls:StraightPipeControl
                        Canvas.Left="293" Canvas.Top="160"
                        Width="82" Height="24"
                        IsFlowing="{Binding BranchPathIsFlowing}"
                        FlowAnimationDirection="Forward"
                        AnimationDuration="0:0:0.5" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <controls:StraightPipeControl
                        Canvas.Left="425" Canvas.Top="160"
                        Width="71" Height="24"
                        IsFlowing="{Binding BranchPathIsFlowing}"
                        FlowAnimationDirection="Forward"
                        AnimationDuration="0:0:0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <controls:ElbowPipeControl Canvas.Left="425" Canvas.Top="215"
                        Width="100" Height="100"
                        Orientation="BottomLeft"
                        IsFlowing="True"
                        FlowAnimationDirection="Reverse" RenderTransformOrigin="-5.95,-6.424" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <controls:ElbowPipeControl Canvas.Left="569" Canvas.Top="122"
                        Width="100" Height="100"
                        Orientation="BottomLeft"
                        IsFlowing="True"
                        FlowAnimationDirection="Reverse" RenderTransformOrigin="-5.95,-6.424" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <controls:ValveControl
                        Canvas.Left="564" Canvas.Top="276"
                        Width="110" Height="100"
                        DeviceName="前级阀"
                        Orientation="Vertical"
                        IsOpen="{Binding BranchValveIsOpen}"
                        IsInterlockReleased="{Binding BranchValveInterlockReleased}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <controls:MfcFlowMeterControl
                        Canvas.Left="140" Canvas.Top="436"
                        Width="170" Height="72"
                        DisplayName="MFC · N2"
                        CurrentFlow="{Binding ArgonCurrentFlow}"
                        SetpointFlow="{Binding ArgonSetpointFlow}"
                        Unit="sccm"
                        ValueFormat="0.0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <controls:MfcFlowMeterControl Canvas.Top="436"
                        Width="170" Height="72"
                        DisplayName="MFC · Ar"
                        CurrentFlow="{Binding ArgonCurrentFlow}"
                        SetpointFlow="{Binding ArgonSetpointFlow}"
                        Unit="sccm"
                        ValueFormat="0.0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <controls:ElbowPipeControl Canvas.Left="570" Canvas.Top="342"
                                               Width="100" Height="100"
                                               Orientation="TopLeft"
                                               IsFlowing="True"
                                               FlowAnimationDirection="Reverse" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <controls:StraightPipeControl
                        Canvas.Left="607" Canvas.Top="222"
                        Width="24" Height="71"
                        Orientation="Vertical"
                        IsFlowing="{Binding BranchPathIsFlowing}"
                        FlowAnimationDirection="Forward" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <controls:StraightPipeControl
                        Canvas.Left="515" Canvas.Top="380"
                        Width="57" Height="24"
                        IsFlowing="{Binding VacuumPathIsFlowing}"
                        FlowAnimationDirection="Reverse" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <controls:StraightPipeControl
                        Canvas.Left="463" Canvas.Top="315"
                        Width="24" Height="40"
                        Orientation="Vertical"
                        IsFlowing="{Binding BranchPathIsFlowing}"
                        FlowAnimationDirection="Forward" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <controls:TurbomolecularPumpControl
                        Canvas.Left="470" Canvas.Top="121"
                        Width="124" Height="124"
                        DeviceName="分子泵"
                        LabelPlacement="Bottom"
                        IsRunning="{Binding TurboPumpIsRunning}"
                        IsInterlockReleased="{Binding TurboPumpInterlockReleased}" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="2.055,0.6"/>
                        <controls:DryPumpControl
                        Canvas.Left="410" Canvas.Top="338"
                        Width="130" Height="130"
                        DeviceName="干泵"
                        LabelPlacement="Bottom"
                        IsRunning="{Binding DryPumpIsRunning}"
                        IsInterlockReleased="{Binding DryPumpInterlockReleased}" RenderTransformOrigin="-2.276,0.82" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <controls:VacuumGaugeControl
                            Canvas.Left="185" Canvas.Top="13"
                            Width="155" Height="101"
                            DisplayName="薄膜真空度计"
                            ReadoutWidth="300" ReadoutHeight="100"
                            TextPlacement="Top"
                            VacuumValue="{Binding ChamberVacuum}"
                            Unit="Pa"
                            ValueFormat="0.0" Loaded="VacuumGaugeControl_Loaded" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <controls:VacuumGaugeControl
                            Canvas.Left="25" Canvas.Top="13"
                            Width="155" Height="101"
                            DisplayName="薄膜真空度计"
                            ReadoutWidth="300" ReadoutHeight="100"
                            TextPlacement="Top"
                            VacuumValue="{Binding ChamberVacuum}"
                            Unit="Pa"
                            ValueFormat="0.0" Loaded="VacuumGaugeControl_Loaded" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="-0.361,0.508"/>
                        <controls:VacuumGaugeControl
                            Canvas.Left="498" Canvas.Top="401"
                            Width="155" Height="101"
                            DisplayName="薄膜真空度计"
                            SymbolRotation="180"
                            ReadoutWidth="300" ReadoutHeight="100"
                            TextPlacement="Bottom"
                            VacuumValue="{Binding ChamberVacuum}"
                            Unit="Pa"
                            ValueFormat="0.0" Loaded="VacuumGaugeControl_Loaded" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Border>

        <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="14,10"
                    Background="#E5F1FB"
                    BorderBrush="#B7D7F0"
                    BorderThickness="1"
                    CornerRadius="6"/>
        <TextBlock Text="APC阀把button类改成数值输入，泄气阀没加"> </TextBlock>
    </Grid>
</Page>

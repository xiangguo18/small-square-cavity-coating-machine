<Page x:Class="Small_square_cavity_coating_machine.Views.Controlview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
      mc:Ignorable="d"
      d:DesignHeight="750"
      d:DesignWidth="1120"
      Background="#EEF2F5"
      Title="系统状态">

    <Page.Resources>
        <Style x:Key="SystemControlButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#E7EDF2"/>
            <Setter Property="BorderBrush" Value="#7D8B95"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#55C878"/>
                    <Setter Property="BorderBrush" Value="#208844"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.78"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <controls:HmiPageLayout PageTitle="系统状态">
        <controls:HmiPageLayout.HeaderRightContent>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse Width="13" Height="13"
                             Fill="#20D34A"
                             Stroke="#263238"
                             StrokeThickness="1.5"/>
                <TextBlock Text="互锁已解除"
                               Margin="7,0,18,0"
                               VerticalAlignment="Center"/>
                <Ellipse Width="13" Height="13"
                             Fill="White"
                             Stroke="#263238"
                             StrokeThickness="1.5"/>
                <TextBlock Text="互锁未解除"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"/>
            </StackPanel>
        </controls:HmiPageLayout.HeaderRightContent>

        <controls:HmiPageLayout.PageContent>
            <Border Padding="12"
                    Background="White"
                    BorderBrush="#D6DEE5"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
            <Viewbox Stretch="Uniform"
                         StretchDirection="Both" Margin="-3,1,3,0">
                <!-- 更宽的逻辑缩放区域使菜单宽度变化在最大化状态下仍能驱动等比例缩放；
                         实际设备画布保持 1020 宽并靠左，680 高度容纳右侧完整控件区。 -->
                <Grid Width="1440" Height="680">
                    <Canvas Width="1020"
                                Height="680"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                        <!-- 腔体与真空度计 -->
                        <!-- 腔体与真空度计 -->
                        <!-- 腔体与真空度计 -->
                        <!-- 腔体与真空度计 -->
                        <!-- 腔体与真空度计 -->
                        <!-- 腔体与真空度计 -->

                        <controls:StraightPipeControl
                        Canvas.Left="553" Canvas.Top="129"
                        Width="47" Height="24"
                        IsFlowing="{Binding ApcToTurboPipeIsFlowing}"
                        FlowAnimationDirection="Forward"
                        AnimationDuration="0:0:0.5" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <!-- 腔体与真空度计 -->

                        <controls:ApcValveControl
                                                          Width="310"
                                                          Height="192"
                                                          FontSize="16"
                                                          DisplayName="APC阀"
                                                          Orientation="Horizontal"
                                                          Placement="TopRight"
                                                          IsPositioningMode="{Binding ApcIsPositioningMode}"
                                                          CurrentPosition="{Binding ApcCurrentPosition}"
                                                          PositionSetpoint="{Binding ApcPositionSetpoint}"
                                                          CurrentPressure="{Binding ApcCurrentPressure}"
                                                          PressureSetpoint="{Binding ApcPressureSetpoint}"
                                                          IsOpen="{Binding ApcIsOpen}"
                                                          IsInterlockReleased="{Binding ApcInterlockReleased}"
                                                          ToggleModeCommand="{Binding ToggleApcModeCommand}"
                                                          PositionSetpointCommand="{Binding SetApcPositionCommand}"
                                                          PressureSetpointCommand="{Binding SetApcPressureCommand}" HorizontalAlignment="Left" Canvas.Left="433" Canvas.Top="20" VerticalAlignment="Top"/>
                        <!-- 腔体与真空度计 -->

                        <controls:StraightPipeControl
                            Canvas.Left="748" Canvas.Top="214"
                            Width="24" Height="37"
                            Orientation="Vertical"
                            IsFlowing="{Binding RightForelineToDryPumpPipeIsFlowing}"
                            FlowAnimationDirection="Forward" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <!-- 腔体与真空度计 -->

                        <controls:StraightPipeControl
                            Canvas.Left="68" Canvas.Top="542"
                            Width="24" Height="38"
                            Orientation="Vertical"
                            IsFlowing="{Binding ArgonMfcPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <controls:StraightPipeControl
                            Canvas.Left="223" Canvas.Top="542"
                            Width="24" Height="38"
                            Orientation="Vertical"
                            IsFlowing="{Binding NitrogenMfcPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <controls:StraightPipeControl
                            Canvas.Left="378" Canvas.Top="542"
                            Width="24" Height="38"
                            Orientation="Vertical"
                            IsFlowing="{Binding OxygenMfcPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <controls:StraightPipeControl
                            Canvas.Left="378" Canvas.Top="473"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding OxygenValvePairPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <controls:StraightPipeControl
                            Canvas.Left="223" Canvas.Top="473"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding NitrogenValvePairPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <controls:StraightPipeControl
                            Canvas.Left="68" Canvas.Top="473"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding ArgonValvePairPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <!-- 腔体与真空度计 -->
                        <controls:ElbowPipeControl Canvas.Left="30" Canvas.Top="345"
                            Width="100" Height="100"
                            Orientation="BottomRight"
                            IsFlowing="{Binding ArgonMixingPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" RenderTransformOrigin="-5.95,-6.424" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <controls:ElbowPipeControl Canvas.Left="340" Canvas.Top="345"
                            Width="100" Height="100"
                            Orientation="BottomLeft"
                            IsFlowing="{Binding OxygenMixingPipeIsFlowing}"
                            FlowAnimationDirection="Forward" RenderTransformOrigin="-5.95,-6.424" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <controls:StraightPipeControl
                            Canvas.Left="222" Canvas.Top="404"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding NitrogenMixingPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <controls:StraightPipeControl
                            Canvas.Left="222" Canvas.Top="349"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding ChamberToMixingPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                        <controls:VacuumGaugeControl
                            Canvas.Left="46"
                            Width="160" Height="120"
                            DisplayName="高真空度计"
                            ReadoutWidth="300" ReadoutHeight="100"
                            TextPlacement="Top"
                            VacuumValue="{Binding HighVacuumValue}"
                            IsReadingEnabled="True"
                            CanToggle="False"
                            Unit="Pa"
                            ValueFormat="0.0" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="-0.361,0.508"/>

                        <controls:VacuumGaugeControl
                            Canvas.Left="265"
                            Width="160" Height="120"
                            DisplayName="薄膜真空度计"
                            ReadoutWidth="300" ReadoutHeight="100"
                            TextPlacement="Top"
                            VacuumValue="{Binding FilmHighVacuumValue}"
                            IsReadingEnabled="{Binding FilmGaugeIsReadingEnabled}"
                            CanToggle="True"
                            ToggleCommand="{Binding ToggleFilmGaugeCommand}"
                            Unit="Pa"
                            ValueFormat="0.0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <!-- 腔体与真空度计 -->

                        <controls:ElbowPipeControl Canvas.Left="423" Canvas.Top="276"
                            Width="101" Height="100"
                            Orientation="BottomLeft"
                            IsFlowing="{Binding ChamberToLowerForelinePipeIsFlowing}"
                            FlowAnimationDirection="Reverse" RenderTransformOrigin="-5.95,-6.424" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Rectangle Canvas.Left="46" Canvas.Top="107"
                               Width="379" Height="247"
                               RadiusX="12" RadiusY="12"
                               Fill="#F7F8FA"
                               Stroke="#34495E"
                               StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <TextBlock Canvas.Left="150" Canvas.Top="217"
                               Width="164"
                               Text="真空腔体"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <!-- 腔体与真空度计 -->

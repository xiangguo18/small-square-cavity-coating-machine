<Page x:Class="Small_square_cavity_coating_machine.Views.Controlview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls"
      mc:Ignorable="d"
      d:DesignHeight="750"
      d:DesignWidth="1120"
      Background="#EEF2F5"
      Title="系统状态">

    <Page.Resources>
        <Style x:Key="SystemControlButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#E7EDF2"/>
            <Setter Property="BorderBrush" Value="#7D8B95"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#55C878"/>
                    <Setter Property="BorderBrush" Value="#208844"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.78"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <controls:HmiPageLayout PageTitle="系统状态">
        <controls:HmiPageLayout.HeaderRightContent>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse Width="13" Height="13"
                             Fill="#20D34A"
                             Stroke="#263238"
                             StrokeThickness="1.5"/>
                <TextBlock Text="互锁已解除"
                               Margin="7,0,18,0"
                               VerticalAlignment="Center"/>
                <Ellipse Width="13" Height="13"
                             Fill="White"
                             Stroke="#263238"
                             StrokeThickness="1.5"/>
                <TextBlock Text="互锁未解除"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"/>
            </StackPanel>
        </controls:HmiPageLayout.HeaderRightContent>

        <controls:HmiPageLayout.PageContent>
            <Grid>
                <Border Padding="12"
                        Background="White"
                        BorderBrush="#D6DEE5"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <!-- 左右控制区保持稳定宽度，中间区域使用运行时的全部剩余空间。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="205"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="348"/>
                        </Grid.ColumnDefinitions>

                        <!-- 中间区域仅承载设备与气路示意图；内部坐标保持不变并独立等比例缩放。 -->
                        <Border Grid.Column="2"
                            Margin="0,10,0,10"
                            Background="#FFFFFF"
                            BorderBrush="#C6D2DC"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                            <Viewbox Margin="6"
                                 Stretch="Uniform"
                                 StretchDirection="Both">
                                <Canvas Width="826"
                                    Height="658">
                                    <!-- 腔体与真空度计 -->
                                    <!-- 腔体与真空度计 -->
                                    <!-- 腔体与真空度计 -->
                                    <!-- 腔体与真空度计 -->
                                    <!-- 腔体与真空度计 -->
                                    <!-- 腔体与真空度计 -->

                                    <controls:StraightPipeControl
                        Canvas.Left="553" Canvas.Top="129"
                        Width="47" Height="24"
                        IsFlowing="{Binding ApcToTurboPipeIsFlowing}"
                        FlowAnimationDirection="Forward"
                        AnimationDuration="0:0:0.5" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                    <!-- 腔体与真空度计 -->

                                    <controls:ApcValveControl
                                                          Width="310"
                                                          Height="192"
                                                          FontSize="16"
                                                          DisplayName="APC阀"
                                                          Orientation="Horizontal"
                                                          Placement="TopRight"
                                                          IsPositioningMode="{Binding ApcIsPositioningMode}"
                                                          CurrentPosition="{Binding ApcCurrentPosition}"
                                                          PositionSetpoint="{Binding ApcPositionSetpoint}"
                                                          CurrentPressure="{Binding ApcCurrentPressure}"
                                                          PressureSetpoint="{Binding ApcPressureSetpoint}"
                                                          IsOpen="{Binding ApcIsOpen}"
                                                          IsInterlockReleased="{Binding ApcInterlockReleased}"
                                                          ToggleModeCommand="{Binding ToggleApcModeCommand}"
                                                          PositionSetpointCommand="{Binding SetApcPositionCommand}"
                                                          PressureSetpointCommand="{Binding SetApcPressureCommand}" HorizontalAlignment="Left" Canvas.Left="433" Canvas.Top="20" VerticalAlignment="Top"/>
                                    <!-- 腔体与真空度计 -->

                                    <controls:StraightPipeControl
                            Canvas.Left="748" Canvas.Top="214"
                            Width="24" Height="37"
                            Orientation="Vertical"
                            IsFlowing="{Binding RightForelineToDryPumpPipeIsFlowing}"
                            FlowAnimationDirection="Forward" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <!-- 腔体与真空度计 -->

                                    <controls:StraightPipeControl
                            Canvas.Left="68" Canvas.Top="542"
                            Width="24" Height="38"
                            Orientation="Vertical"
                            IsFlowing="{Binding ArgonMfcPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="223" Canvas.Top="542"
                            Width="24" Height="38"
                            Orientation="Vertical"
                            IsFlowing="{Binding NitrogenMfcPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="378" Canvas.Top="542"
                            Width="24" Height="38"
                            Orientation="Vertical"
                            IsFlowing="{Binding OxygenMfcPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="378" Canvas.Top="473"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding OxygenValvePairPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="223" Canvas.Top="473"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding NitrogenValvePairPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="68" Canvas.Top="473"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding ArgonValvePairPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <!-- 腔体与真空度计 -->
                                    <controls:ElbowPipeControl Canvas.Left="30" Canvas.Top="345"
                            Width="100" Height="100"
                            Orientation="BottomRight"
                            IsFlowing="{Binding ArgonMixingPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" RenderTransformOrigin="-5.95,-6.424" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:ElbowPipeControl Canvas.Left="340" Canvas.Top="345"
                            Width="100" Height="100"
                            Orientation="BottomLeft"
                            IsFlowing="{Binding OxygenMixingPipeIsFlowing}"
                            FlowAnimationDirection="Forward" RenderTransformOrigin="-5.95,-6.424" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="222" Canvas.Top="404"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding NitrogenMixingPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="222" Canvas.Top="349"
                            Width="24" Height="30"
                            Orientation="Vertical"
                            IsFlowing="{Binding ChamberToMixingPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                                    <controls:VacuumGaugeControl
                            Canvas.Left="46"
                            Width="160" Height="120"
                            DisplayName="高真空度计"
                            ReadoutWidth="300" ReadoutHeight="100"
                            TextPlacement="Top"
                            VacuumValue="{Binding HighVacuumValue}"
                            IsReadingEnabled="True"
                            CanToggle="False"
                            Unit="Pa"
                            ValueFormat="0.0" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="-0.361,0.508"/>

                                    <controls:VacuumGaugeControl
                            Canvas.Left="265"
                            Width="160" Height="120"
                            DisplayName="薄膜真空度计"
                            ReadoutWidth="300" ReadoutHeight="100"
                            TextPlacement="Top"
                            VacuumValue="{Binding FilmHighVacuumValue}"
                            IsReadingEnabled="{Binding FilmGaugeIsReadingEnabled}"
                            CanToggle="True"
                            ToggleCommand="{Binding ToggleFilmGaugeCommand}"
                            Unit="Pa"
                            ValueFormat="0.0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <!-- 腔体与真空度计 -->

                                    <controls:ElbowPipeControl Canvas.Left="423" Canvas.Top="276"
                            Width="101" Height="100"
                            Orientation="BottomLeft"
                            IsFlowing="{Binding ChamberToLowerForelinePipeIsFlowing}"
                            FlowAnimationDirection="Reverse" RenderTransformOrigin="-5.95,-6.424" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Rectangle Canvas.Left="46" Canvas.Top="107"
                               Width="379" Height="247"
                               RadiusX="12" RadiusY="12"
                               Fill="#F7F8FA"
                               Stroke="#34495E"
                               StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock Canvas.Left="150" Canvas.Top="217"
                               Width="164"
                               Text="真空腔体"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <!-- 腔体与真空度计 -->
                                    <controls:ValveControl
                            Canvas.Left="25" Canvas.Top="414"
                            Width="110" Height="100"
                            DeviceName="前级阀"
                            Orientation="Vertical"
                            IsOpen="{Binding ArgonUpperValveIsOpen}"
                            IsInterlockReleased="{Binding ArgonUpperValveInterlockReleased}"
                            Command="{Binding ToggleArgonUpperValveCommand}" HorizontalAlignment="Center" VerticalAlignment="Top" Click="ValveControl_Click"/>
                                    <controls:ValveControl
                            Canvas.Left="180" Canvas.Top="414"
                            Width="110" Height="100"
                            DeviceName="前级阀"
                            Orientation="Vertical"
                            IsOpen="{Binding NitrogenUpperValveIsOpen}"
                            IsInterlockReleased="{Binding NitrogenUpperValveInterlockReleased}"
                            Command="{Binding ToggleNitrogenUpperValveCommand}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:ValveControl
                            Canvas.Left="335" Canvas.Top="414"
                            Width="110" Height="100"
                            DeviceName="前级阀"
                            Orientation="Vertical"
                            IsOpen="{Binding OxygenUpperValveIsOpen}"
                            IsInterlockReleased="{Binding OxygenUpperValveInterlockReleased}"
                            Command="{Binding ToggleOxygenUpperValveCommand}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:ValveControl
                            Canvas.Left="180" Canvas.Top="484"
                            Width="110" Height="100"
                            DeviceName="前级阀"
                            Orientation="Vertical"
                            IsOpen="{Binding NitrogenLowerValveIsOpen}"
                            IsInterlockReleased="{Binding NitrogenLowerValveInterlockReleased}"
                            Command="{Binding ToggleNitrogenLowerValveCommand}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:ValveControl
                            Canvas.Left="25" Canvas.Top="484"
                            Width="110" Height="100"
                            DeviceName="前级阀"
                            Orientation="Vertical"
                            IsOpen="{Binding ArgonLowerValveIsOpen}"
                            IsInterlockReleased="{Binding ArgonLowerValveInterlockReleased}"
                            Command="{Binding ToggleArgonLowerValveCommand}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <!-- 腔体右侧：横管、横阀、弯头和干泵 -->
                                    <controls:ValveControl
                        Canvas.Left="479" Canvas.Top="222"
                        Width="111" Height="100"
                        DeviceName="旁抽阀"
                        Orientation="Horizontal"
                        IsOpen="{Binding BypassValveIsOpen}"
                        IsInterlockReleased="{Binding BypassValveInterlockReleased}"
                        Command="{Binding ToggleBypassValveCommand}" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                                    <!-- MFC 三行显示 -->
                                    <controls:MfcFlowMeterControl
                        Canvas.Left="305" Canvas.Top="577"
                        Width="170" Height="80"
                        DisplayName="MFC · O2"
                        CurrentFlow="{Binding OxygenCurrentFlow}"
                        SetpointFlow="{Binding ArgonSetpointFlow}"
                        Unit="sccm"
                        ValueFormat="0.0" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                    <!-- 直管 + 两个弯头拼成连续的U形管路 -->
                                    <controls:StraightPipeControl
                        Canvas.Left="425" Canvas.Top="246"
                        Width="82" Height="24"
                        IsFlowing="{Binding ChamberToBypassPipeIsFlowing}"
                        FlowAnimationDirection="Forward" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                                    <!-- 四种弯头方向，用于在设计器中复制 -->
                                    <controls:StraightPipeControl
                        Canvas.Left="425" Canvas.Top="130"
                        Width="82" Height="24"
                        IsFlowing="{Binding ChamberToApcPipeIsFlowing}"
                        FlowAnimationDirection="Forward"
                        AnimationDuration="0:0:0.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <controls:ElbowPipeControl Canvas.Left="710" Canvas.Top="91"
                        Width="100" Height="100"
                        Orientation="BottomLeft"
                        IsFlowing="{Binding TurboToRightForelinePipeIsFlowing}"
                        FlowAnimationDirection="Reverse" RenderTransformOrigin="-5.95,-6.424" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:MfcFlowMeterControl
                        Canvas.Left="150" Canvas.Top="577"
                        Width="170" Height="80"
                        DisplayName="MFC · N2"
                        CurrentFlow="{Binding NitrogenCurrentFlow}"
                        SetpointFlow="{Binding ArgonSetpointFlow}"
                        Unit="sccm"
                        ValueFormat="0.0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <controls:MfcFlowMeterControl Canvas.Top="577"
                        Width="170" Height="80"
                        DisplayName="MFC · Ar"
                        CurrentFlow="{Binding ArgonCurrentFlow}"
                        SetpointFlow="{Binding ArgonSetpointFlow}"
                        Unit="sccm"
                        ValueFormat="0.0" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Left="-5"/>
                                    <controls:StraightPipeControl
                        Canvas.Left="461" Canvas.Top="408"
                        Width="24" Height="37"
                        Orientation="Vertical"
                        IsFlowing="{Binding ChamberToLowerForelinePipeIsFlowing}"
                        FlowAnimationDirection="Forward" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:StraightPipeControl
                        Canvas.Left="658" Canvas.Top="129"
                        Width="52" Height="24"
                        IsFlowing="{Binding TurboToRightForelinePipeIsFlowing}"
                        FlowAnimationDirection="Forward" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.653,-3.247"/>
                                    <controls:TurbomolecularPumpControl
                        Canvas.Left="578" Canvas.Top="99"
                        Width="100" Height="100"
                        DeviceName="分子泵"
                        LabelPlacement="Bottom"
                        IsRunning="{Binding TurboPumpIsRunning}"
                        IsInterlockReleased="{Binding TurboPumpInterlockReleased}"
                        Command="{Binding ToggleTurboPumpCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="2.055,0.6"/>
                                    <controls:VacuumGaugeControl
                            Canvas.Left="535" Canvas.Top="259"
                            Width="160" Height="120"
                            DisplayName="前级真空度计"
                            SymbolRotation="180"
                            ReadoutWidth="300" ReadoutHeight="100"
                            TextPlacement="Bottom"
                            VacuumValue="{Binding ForelineVacuumValue}"
                            IsReadingEnabled="True"
                            CanToggle="False"
                            Unit="Pa"
                            ValueFormat="0.0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="130" Canvas.Top="383"
                            Width="55" Height="24"
                            IsFlowing="{Binding ArgonMixingPipeIsFlowing}"
                            FlowAnimationDirection="Forward" RenderTransformOrigin="0.653,-3.247" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="283" Canvas.Top="383"
                            Width="57" Height="24"
                            IsFlowing="{Binding OxygenMixingPipeIsFlowing}"
                            FlowAnimationDirection="Reverse" RenderTransformOrigin="0.653,-3.247" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <controls:StraightPipeControl
                            Canvas.Left="557" Canvas.Top="246"
                            Width="196" Height="24"
                            IsFlowing="{Binding BypassToDryPumpPipeIsFlowing}"
                            FlowAnimationDirection="Forward" RenderTransformOrigin="0.653,-3.247" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Rectangle Canvas.Left="185" Canvas.Top="372" Width="99" Height="46" RadiusX="12" RadiusY="12"
                               Fill="#F7F8FA" Stroke="#34495E" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.484,0.322" />
                                    <TextBlock Canvas.Left="152" Canvas.Top="378"
                            Width="164"
                            Text="混气室"
                            FontSize="25"
                            FontWeight="SemiBold"
                            Foreground="#34495E"
                            TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <controls:ValveControl
                            Canvas.Left="335" Canvas.Top="484"
                            Width="110" Height="100"
                            DeviceName="前级阀"
                            Orientation="Vertical"
                            IsOpen="{Binding OxygenLowerValveIsOpen}"
                            IsInterlockReleased="{Binding OxygenLowerValveInterlockReleased}"
                            Command="{Binding ToggleOxygenLowerValveCommand}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <controls:ValveControl
                        Canvas.Left="705" Canvas.Top="158"
                        Width="110" Height="100"
                        DeviceName="前级阀"
                        Orientation="Vertical"
                        IsOpen="{Binding RightForelineValveIsOpen}"
                        IsInterlockReleased="{Binding RightForelineValveInterlockReleased}"
                        Command="{Binding ToggleRightForelineValveCommand}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <Rectangle Canvas.Left="747" Canvas.Top="246" Width="25" Height="44" RadiusX="5" RadiusY="5"
                            Fill="#F7F8FA" Stroke="#34495E" StrokeThickness="3" RenderTransformOrigin="0.484,0.322" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    <controls:DryPumpControl
                        Canvas.Left="710" Canvas.Top="268"
                        Width="100" Height="100"
                        DeviceName="干泵"
                        LabelPlacement="Bottom"
                        IsRunning="{Binding DryPumpIsRunning}"
                        IsInterlockReleased="{Binding DryPumpInterlockReleased}"
                        Command="{Binding ToggleDryPumpCommand}" RenderTransformOrigin="-2.276,0.82" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <controls:ValveControl
                            Canvas.Left="423" Canvas.Top="349"
                            Width="101" Height="100"
                            DeviceName="前级阀"
                            Orientation="Vertical"
                            IsOpen="{Binding LowerForelineValveIsOpen}"
                            IsInterlockReleased="{Binding LowerForelineValveInterlockReleased}"
                            Command="{Binding ToggleLowerForelineValveCommand}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- 系统级离线演示命令；后续由 OPC UA 命令确认流程替换。 -->
                        <Border Grid.Column="0"
                            Margin="0,10,0,10"
                            Padding="10"
                            Background="#F3F6F8"
                            BorderBrush="#C6D2DC"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                    Margin="0,0,0,6"
                                    Padding="7"
                                    Background="#F8FAFC"
                                    BorderBrush="#AEBCC8"
                                    BorderThickness="1.5"
                                    CornerRadius="7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="运行控制"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2D3D"
                                               TextAlignment="Center"/>
                                        <UniformGrid Grid.Row="1" Rows="2" Columns="2">
                                            <Button Content="开启"
                                                Style="{StaticResource SystemControlButtonStyle}"
                                                Tag="{Binding SystemIsRunning}"
                                                Command="{Binding StartSystemCommand}"/>
                                            <Button Content="停止"
                                                Style="{StaticResource SystemControlButtonStyle}"
                                                Tag="{Binding SystemIsStopped}"
                                                Command="{Binding StopSystemCommand}"/>
                                            <Button Content="复位"
                                                Style="{StaticResource SystemControlButtonStyle}"
                                                Command="{Binding ResetSystemCommand}"/>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                    Margin="0,3"
                                    Padding="7"
                                    Background="#F8FAFC"
                                    BorderBrush="#AEBCC8"
                                    BorderThickness="1.5"
                                    CornerRadius="7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="运行模式"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2D3D"
                                               TextAlignment="Center"/>
                                        <UniformGrid Grid.Row="1" Rows="2" Columns="2">
                                            <Button Content="自动"
                                                Style="{StaticResource SystemControlButtonStyle}"
                                                Tag="{Binding AutomaticModeIsSelected}"
                                                Command="{Binding SelectAutomaticModeCommand}"/>
                                            <Button Content="半自动"
                                                Style="{StaticResource SystemControlButtonStyle}"
                                                Tag="{Binding SemiAutomaticModeIsSelected}"
                                                Command="{Binding SelectSemiAutomaticModeCommand}"/>
                                            <Button Content="手动"
                                                Style="{StaticResource SystemControlButtonStyle}"
                                                Tag="{Binding ManualModeIsSelected}"
                                                Command="{Binding SelectManualModeCommand}"/>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2"
                                    Margin="0,6,0,0"
                                    Padding="7"
                                    Background="#F8FAFC"
                                    BorderBrush="#AEBCC8"
                                    BorderThickness="1.5"
                                    CornerRadius="7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="真空控制"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2D3D"
                                               TextAlignment="Center"/>
                                        <UniformGrid Grid.Row="1" Rows="2" Columns="2">
                                            <Button Content="抽真空"
                                                Style="{StaticResource SystemControlButtonStyle}"
                                                Tag="{Binding VacuumingIsSelected}"
                                                Command="{Binding StartVacuumCommand}"/>
                                            <Button Content="破真空"
                                                Style="{StaticResource SystemControlButtonStyle}"
                                                Tag="{Binding VentingIsSelected}"
                                                Command="{Binding BreakVacuumCommand}"/>
                                            <Button Content="保压"
                                                Style="{StaticResource SystemControlButtonStyle}"
                                                Tag="{Binding PressureHoldingIsSelected}"
                                                Command="{Binding HoldPressureCommand}"/>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 右侧设备控制区使用明确的纵向行布局。 -->
                        <Border Grid.Column="4"
                            Margin="0,10,0,10"
                            Padding="10"
                            Background="#F3F6F8"
                            BorderBrush="#C6D2DC"
                            BorderThickness="1"
                            CornerRadius="8">
                            <!-- 右侧控件按 420×640 的设计基准整体等比缩小，避免高 DPI 下底部被裁切。 -->
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="DownOnly">
                                <Grid Width="420"
                                  Height="640">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100"/>
                                        <RowDefinition Height="132"/>
                                        <RowDefinition Height="132"/>
                                        <RowDefinition Height="116"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <controls:HeaterControl Grid.Row="0"
                                                    Height="94"
                                                    Margin="0,-9,0,15"
                                                    DisplayName="加热"
                                                    CurrentTemperature="{Binding HeaterCurrentTemperature}"
                                                    SetpointTemperature="{Binding HeaterSetpointTemperature}"
                                                    IsRunning="{Binding HeaterIsRunning}"
                                                    IsInterlockReleased="{Binding HeaterInterlockReleased}"
                                                    ToggleCommand="{Binding ToggleHeaterCommand}"
                                                    SetpointCommand="{Binding SetHeaterTemperatureCommand}"/>

                                    <controls:PowerSupplyControl
                                                       Margin="0,90,0,10"
                                                       DisplayName="电源1"
                                                       SetpointPower="{Binding Power1Setpoint}"
                                                       MeasuredPower="{Binding Power1MeasuredPower}"
                                                       MeasuredVoltage="{Binding Power1MeasuredVoltage}"
                                                       MeasuredCurrent="{Binding Power1MeasuredCurrent}"
                                                       IsRunning="{Binding Power1IsRunning}"
                                                       IsInterlockReleased="{Binding Power1InterlockReleased}"

<Application x:Class="Small_square_cavity_coating_machine.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Small_square_cavity_coating_machine"
             StartupUri="Views/MainView.xaml">
    <Application.Resources>

        <!-- RadioButton Style -->
        <Style x:Key="sty1"
       TargetType="{x:Type RadioButton}">
            <!-- 默认状态 -->
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <!-- RadioButton 被选中 -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#0078D4"/>
                    <Setter Property="Background" Value="#DCEEFF"/>
                </Trigger>
                <!-- 鼠标移入，但尚未选中 -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>

                    <Setter Property="Foreground" Value="#005A9E"/>
                    <Setter Property="Background" Value="#EAF4FF"/>
                </MultiTrigger>
                <!-- 控件被禁用 -->
                <Trigger Property="IsEnabled"  Value="False">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </Application.Resources>
</Application>

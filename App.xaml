<Application x:Class="Small_square_cavity_coating_machine.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Small_square_cavity_coating_machine">
    <Application.Resources>

        <!-- RadioButton Style -->
        <Style x:Key="sty1"
       TargetType="{x:Type RadioButton}">
            <!-- 默认状态 -->
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <!-- RadioButton 被选中 -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#0078D4"/>
                    <Setter Property="Background" Value="#DCEEFF"/>
                </Trigger>
                <!-- 鼠标移入，但尚未选中 -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>

                    <Setter Property="Foreground" Value="#005A9E"/>
                    <Setter Property="Background" Value="#EAF4FF"/>
                </MultiTrigger>
                <!-- 控件被禁用 -->
                <Trigger Property="IsEnabled"  Value="False">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryTabItemStyle"
               TargetType="{x:Type TabItem}">
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Foreground" Value="#334A5F"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="#F3F7FA"
                                BorderBrush="#AFC3D2"
                                BorderThickness="1"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E8F3FC"/>
                                <Setter Property="Foreground" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#DCEEFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrendTabItemStyle"
               TargetType="{x:Type TabItem}"
               BasedOn="{StaticResource HistoryTabItemStyle}">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,4"/>
        </Style>

        <Style x:Key="HistoryTabControlStyle"
               TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      Margin="0"
                                      HorizontalAlignment="Left"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Panel.ZIndex="1"/>
                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="#D3DDE5"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="4"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrendTabControlStyle"
               TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      HorizontalAlignment="Left"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Panel.ZIndex="1"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryLargeCalendarStyle"
               TargetType="{x:Type Calendar}">
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="2.2"
                                    ScaleY="2.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryDatePickerStyle"
               TargetType="{x:Type DatePicker}">
            <Setter Property="Width" Value="174"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CalendarStyle"
                    Value="{StaticResource HistoryLargeCalendarStyle}"/>
        </Style>
        
    </Application.Resources>
</Application>

<Window x:Class="Small_square_cavity_coating_machine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Small_square_cavity_coating_machine"
        mc:Ignorable="d"
        Title="单腔室磁控溅射镀膜机" Height="750" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="gridMenu1" Grid.Column="0" Width="80" Background="LightBlue">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <!-- Logo -->
            <StackPanel Background="LightBlue" Orientation="Horizontal">
                <Image Source="/Resources/logo.png" 
                       Width="60" Height="60" 
                       Margin="10 0 0 0" 
                       VerticalAlignment="Center" 
                       Stretch="Uniform"></Image>
                <Image Source="/Resources/title.png" 
                       Margin="20 0 0 0" 
                       VerticalAlignment="Center" 
                       Stretch="Uniform"></Image>
            </StackPanel>


            <!-- 折叠状态栏按钮 -->
            <ToggleButton Grid.Row="1" 
                          Content="&#xF039;" 
                          FontSize="30" 
                          FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                          FontWeight="Black"
                          Background="LightBlue"
                          BorderThickness="0"
                          BorderBrush="Transparent">
                <ToggleButton.Triggers>
                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                        <BeginStoryboard>
                            <Storyboard x:Name="closeMenu">
                                <DoubleAnimation Storyboard.TargetName="gridMenu1" 
                                                 Storyboard.TargetProperty="Width" From="260" To="80"
                                                 Duration="0:0:0.5">
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                        <BeginStoryboard>
                            <Storyboard x:Name="showMenu">
                                <DoubleAnimation Storyboard.TargetName="gridMenu1" 
                                                 Storyboard.TargetProperty="Width" From="60" To="260"
                                                 Duration="0:0:0.5">
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ToggleButton.Triggers>
            </ToggleButton>

            <!-- 功能菜单栏 -->
            <StackPanel Grid.Row="2" Background="lightBlue">

                <!-- 1 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="gridIO1" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <!-- 图标列中心线对齐 -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- 文字列中心线对齐 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <TextBlock x:Name="IconTextIO1"
                                           Grid.Column="0"
                                           Text="&#xF2DB;"
                                           FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                           FontWeight="Black"
                                           FontSize="35"
                                           Foreground="Black"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock x:Name="TitleTextIO1"
                                           Grid.Column="1"
                                           Text="I/O状态"
                                           FontSize="35"
                                           Foreground="Black"
                                           Margin="25,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 属性触发器 -->
                            <ControlTemplate.Triggers>
                                <!-- RadioButton被选中 -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="IconTextIO1" Property="Foreground" Value="#0078D4"/>
                                    <Setter TargetName="TitleTextIO1" Property="Foreground" Value="#0078D4"/>
                                    <Setter TargetName="gridIO1" Property="Background" Value="#DCEEFF"/>
                                </Trigger>

                                <!-- 鼠标移入，但尚未选中 -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="IconTextIO1" Property="Foreground" Value="#005A9E"/>
                                    <Setter TargetName="TitleTextIO1" Property="Foreground" Value="#005A9E"/>
                                    <Setter TargetName="gridIO1" Property="Background" Value="#EAF4FF"/>
                                </MultiTrigger>

                                <!-- 控件被禁用 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="IconTextIO1" Property="Foreground" Value="Gray"/>
                                    <Setter TargetName="TitleTextIO1" Property="Foreground" Value="Gray"/>
                                    <Setter TargetName="gridIO1" Property="Opacity" Value="0.6"/>
                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>

                <!-- 2 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="gridParameter1" Background="Transparent">

                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>

                <!-- 6 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="gridSystem1" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <!-- 图标列中心线对齐 -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- 文字列中心线对齐 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <TextBlock x:Name="IconTextSystem1"
                                           Grid.Column="0"
                                           Text="&#xF084;"
                                           FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                           FontWeight="Black"
                                           FontSize="35"
                                           Foreground="Black"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock x:Name="TitleTextSystem1"
                                           Grid.Column="1"
                                           Text="用户权限"
                                           FontSize="35"

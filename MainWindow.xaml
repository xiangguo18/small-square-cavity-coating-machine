                                           FontFamily="../Resources/Fonts/#Font Awesome 5 Free"
                                           FontWeight="Black"
                                           FontSize="35"
                                           Foreground="Black"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock x:Name="TitleTextParameter1"
                                           Grid.Column="1"
                                           Text="参数设置"
                                           FontSize="35"
                                           Foreground="Black"
                                           Margin="15,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 属性触发器 -->
                            <ControlTemplate.Triggers>
                                <!-- RadioButton被选中 -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="IconTextParameter1" Property="Foreground" Value="#0078D4"/>
                                    <Setter TargetName="TitleTextParameter1" Property="Foreground" Value="#0078D4"/>
                                    <Setter TargetName="gridParameter1" Property="Background" Value="#DCEEFF"/>
                                </Trigger>

                                <!-- 鼠标移入，但尚未选中 -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="IconTextParameter1" Property="Foreground" Value="#005A9E"/>
                                    <Setter TargetName="TitleTextParameter1" Property="Foreground" Value="#005A9E"/>
                                    <Setter TargetName="gridParameter1" Property="Background" Value="#EAF4FF"/>
                                </MultiTrigger>

                                <!-- 控件被禁用 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="IconTextParameter1" Property="Foreground" Value="Gray"/>
                                    <Setter TargetName="TitleTextParameter1" Property="Foreground" Value="Gray"/>
                                    <Setter TargetName="gridParameter1" Property="Opacity" Value="0.6"/>
                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>


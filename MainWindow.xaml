                                           FontWeight="Black"
                                           FontSize="35"
                                           Foreground="Black"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- 文字 -->
                                <TextBlock x:Name="TitleTextSystem1"

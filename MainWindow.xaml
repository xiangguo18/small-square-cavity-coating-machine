                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="IconTextSystem1" Property="Foreground" Value="#005A9E"/>
                                    <Setter TargetName="TitleTextSystem1" Property="Foreground" Value="#005A9E"/>
                                    <Setter TargetName="gridSystem1" Property="Background" Value="#EAF4FF"/>
                                </MultiTrigger>

                                <!-- 控件被禁用 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="IconTextSystem1" Property="Foreground" Value="Gray"/>
                                    <Setter TargetName="TitleTextSystem1" Property="Foreground" Value="Gray"/>
                                    <Setter TargetName="gridSystem1" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </RadioButton.Template>

                </RadioButton>

                <!-- 4 -->
                <RadioButton Height="64" Margin="0" HorizontalAlignment="Stretch">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="gridSystem1" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <!-- 图标列中心线对齐 -->
                                    <ColumnDefinition Width="80"/>
                                    <!-- 文字列中心线对齐 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <TextBlock x:Name="IconTextSystem1"
                                           Grid.Column="0"
                                           Text="&#xF0AE;"

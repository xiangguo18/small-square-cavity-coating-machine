<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Small_square_cavity_coating_machine.Controls">

    <SolidColorBrush x:Key="DeviceOutlineBrush" Color="#263238"/>
    <SolidColorBrush x:Key="DeviceIdleBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DeviceActiveBrush" Color="#55C878"/>
    <SolidColorBrush x:Key="DeviceFaultBrush" Color="#EF5350"/>
    <SolidColorBrush x:Key="PipeBodyBrush" Color="#B8C2CC"/>
    <SolidColorBrush x:Key="PipeFlowBrush" Color="#147BD1"/>
    <controls:VerticalTextConverter x:Key="VerticalTextConverter"/>

    <!-- 阀门：两个三角形组成沙漏图案。 -->
    <Style TargetType="{x:Type controls:ValveControl}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ValveControl}">
                    <Border Background="{TemplateBinding Background}"
                            ToolTip="{TemplateBinding DeviceName}">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="120" Height="120">
                                <Ellipse x:Name="InterlockLamp"
                                         Canvas.Left="8" Canvas.Top="7"
                                         Width="15" Height="15"
                                         Fill="White"
                                         Stroke="{StaticResource DeviceOutlineBrush}"
                                         StrokeThickness="2"/>

                                <Canvas x:Name="ValveVisual"
                                        Width="120" Height="94"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Canvas.RenderTransform>
                                    <Path x:Name="ValveBodyTop"
                                          Data="M 31,22 L 89,22 L 60,50 Z"
                                          Fill="{StaticResource DeviceIdleBrush}"
                                          Stroke="{StaticResource DeviceOutlineBrush}"
                                          StrokeThickness="4"
                                          StrokeLineJoin="Round"/>
                                    <Path x:Name="ValveBodyBottom"
                                          Data="M 31,78 L 89,78 L 60,50 Z"
                                          Fill="{StaticResource DeviceIdleBrush}"
                                          Stroke="{StaticResource DeviceOutlineBrush}"
                                          StrokeThickness="4"
                                          StrokeLineJoin="Round"/>
                                </Canvas>

                                <!-- 横向阀门的名称放在图形下方。 -->
                                <TextBlock x:Name="HorizontalValveLabel"
                                           Canvas.Left="5" Canvas.Top="89"
                                           Width="110" Height="20"
                                           Visibility="Collapsed"
                                           Text="{TemplateBinding DeviceName}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- 竖向阀门的名称放在图形右侧并逐字向下排列。 -->
                                <TextBlock x:Name="VerticalValveLabel"
                                           Canvas.Left="94" Canvas.Top="25"
                                           Width="20" Height="68"
                                           Text="{Binding DeviceName,
                                               RelativeSource={RelativeSource TemplatedParent},
                                               Converter={StaticResource VerticalTextConverter}}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           LineHeight="18"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="ValveVisual" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="HorizontalValveLabel"
                                    Property="Visibility"
                                    Value="Visible"/>
                            <Setter TargetName="VerticalValveLabel"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="ValveBodyTop" Property="Fill"
                                    Value="{StaticResource DeviceActiveBrush}"/>
                            <Setter TargetName="ValveBodyBottom" Property="Fill"
                                    Value="{StaticResource DeviceActiveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsInterlockReleased" Value="True">
                            <Setter TargetName="InterlockLamp" Property="Fill" Value="#20D34A"/>
                        </Trigger>
                        <Trigger Property="IsFaulted" Value="True">
                            <Setter TargetName="ValveBodyTop" Property="Fill"
                                    Value="{StaticResource DeviceFaultBrush}"/>
                            <Setter TargetName="ValveBodyBottom" Property="Fill"
                                    Value="{StaticResource DeviceFaultBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分子泵：参考图中的外圆、两侧轮廓和中心空心同心圆。 -->
    <Style TargetType="{x:Type controls:TurbomolecularPumpControl}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="58"/>
        <Setter Property="MinHeight" Value="58"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TurbomolecularPumpControl}">
                    <Border Background="{TemplateBinding Background}"
                            ToolTip="{TemplateBinding DeviceName}">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="130" Height="130">
                                <Ellipse x:Name="InterlockLamp"
                                         Canvas.Left="7" Canvas.Top="8"
                                         Width="16" Height="16"
                                         Fill="White"
                                         Stroke="{StaticResource DeviceOutlineBrush}"
                                         StrokeThickness="2"/>
                                <Ellipse x:Name="PumpBody"
                                         Canvas.Left="24" Canvas.Top="16"
                                         Width="82" Height="78"
                                         Fill="{StaticResource DeviceIdleBrush}"
                                         Stroke="{StaticResource DeviceOutlineBrush}"
                                         StrokeThickness="4"/>
                                <Path Data="M 31,35 Q 42,55 32,76"
                                      Fill="Transparent"
                                      Stroke="{StaticResource DeviceOutlineBrush}"
                                      StrokeThickness="4"/>
                                <Path Data="M 99,35 Q 88,55 98,76"
                                      Fill="Transparent"
                                      Stroke="{StaticResource DeviceOutlineBrush}"
                                      StrokeThickness="4"/>
                                <Ellipse Canvas.Left="49" Canvas.Top="40"
                                         Width="32" Height="32"
                                         Fill="Transparent"
                                         Stroke="{StaticResource DeviceOutlineBrush}"
                                         StrokeThickness="4"/>
                                <Ellipse Canvas.Left="57" Canvas.Top="48"
                                         Width="16" Height="16"
                                         Fill="Transparent"
                                         Stroke="{StaticResource DeviceOutlineBrush}"
                                         StrokeThickness="3"/>
                                <TextBlock x:Name="PumpLabelRight"
                                           Canvas.Left="108" Canvas.Top="25"
                                           Width="20" Height="68"
                                           Text="{Binding DeviceName,
                                               RelativeSource={RelativeSource TemplatedParent},
                                               Converter={StaticResource VerticalTextConverter}}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           LineHeight="18"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PumpLabelLeft"
                                           Canvas.Left="2" Canvas.Top="25"
                                           Width="20" Height="68"
                                           Visibility="Collapsed"
                                           Text="{Binding DeviceName,
                                               RelativeSource={RelativeSource TemplatedParent},
                                               Converter={StaticResource VerticalTextConverter}}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           LineHeight="18"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PumpLabelTop"
                                           Canvas.Left="25" Canvas.Top="0"
                                           Width="80" Height="18"
                                           Visibility="Collapsed"
                                           Text="{TemplateBinding DeviceName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PumpLabelBottom"
                                           Canvas.Left="25" Canvas.Top="96"
                                           Width="80" Height="20"
                                           Visibility="Collapsed"
                                           Text="{TemplateBinding DeviceName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="LabelPlacement"
                                 Value="{x:Static controls:PumpLabelPlacement.Left}">
                            <Setter TargetName="PumpLabelRight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PumpLabelLeft" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="LabelPlacement"
                                 Value="{x:Static controls:PumpLabelPlacement.Top}">
                            <Setter TargetName="PumpLabelRight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PumpLabelTop" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="LabelPlacement"
                                 Value="{x:Static controls:PumpLabelPlacement.Bottom}">
                            <Setter TargetName="PumpLabelRight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PumpLabelBottom" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsRunning" Value="True">
                            <Setter TargetName="PumpBody" Property="Fill"
                                    Value="{StaticResource DeviceActiveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsInterlockReleased" Value="True">
                            <Setter TargetName="InterlockLamp" Property="Fill" Value="#20D34A"/>
                        </Trigger>
                        <Trigger Property="IsFaulted" Value="True">
                            <Setter TargetName="PumpBody" Property="Fill"
                                    Value="{StaticResource DeviceFaultBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 干泵：与分子泵轮廓一致，中心改为实心。 -->
    <Style TargetType="{x:Type controls:DryPumpControl}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="58"/>
        <Setter Property="MinHeight" Value="58"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DryPumpControl}">
                    <Border Background="{TemplateBinding Background}"
                            ToolTip="{TemplateBinding DeviceName}">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="130" Height="130">
                                <Ellipse x:Name="InterlockLamp"
                                         Canvas.Left="7" Canvas.Top="8"
                                         Width="16" Height="16"
                                         Fill="White"
                                         Stroke="{StaticResource DeviceOutlineBrush}"
                                         StrokeThickness="2"/>
                                <Ellipse x:Name="PumpBody"
                                         Canvas.Left="24" Canvas.Top="16"
                                         Width="82" Height="78"
                                         Fill="{StaticResource DeviceIdleBrush}"
                                         Stroke="{StaticResource DeviceOutlineBrush}"
                                         StrokeThickness="4"/>
                                <Path Data="M 31,35 Q 42,55 32,76"
                                      Fill="Transparent"
                                      Stroke="{StaticResource DeviceOutlineBrush}"
                                      StrokeThickness="4"/>
                                <Path Data="M 99,35 Q 88,55 98,76"
                                      Fill="Transparent"
                                      Stroke="{StaticResource DeviceOutlineBrush}"
                                      StrokeThickness="4"/>
                                <Ellipse Canvas.Left="50" Canvas.Top="41"
                                         Width="30" Height="30"
                                         Fill="{StaticResource DeviceOutlineBrush}"
                                         Stroke="{StaticResource DeviceOutlineBrush}"
                                         StrokeThickness="3"/>
                                <TextBlock x:Name="PumpLabelRight"
                                           Canvas.Left="108" Canvas.Top="25"
                                           Width="20" Height="68"
                                           Text="{Binding DeviceName,
                                               RelativeSource={RelativeSource TemplatedParent},
                                               Converter={StaticResource VerticalTextConverter}}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           LineHeight="18"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PumpLabelLeft"
                                           Canvas.Left="2" Canvas.Top="25"
                                           Width="20" Height="68"
                                           Visibility="Collapsed"
                                           Text="{Binding DeviceName,
                                               RelativeSource={RelativeSource TemplatedParent},
                                               Converter={StaticResource VerticalTextConverter}}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           LineHeight="18"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PumpLabelTop"
                                           Canvas.Left="25" Canvas.Top="0"
                                           Width="80" Height="18"
                                           Visibility="Collapsed"
                                           Text="{TemplateBinding DeviceName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PumpLabelBottom"
                                           Canvas.Left="25" Canvas.Top="96"
                                           Width="80" Height="20"
                                           Visibility="Collapsed"
                                           Text="{TemplateBinding DeviceName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DeviceOutlineBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="LabelPlacement"
                                 Value="{x:Static controls:PumpLabelPlacement.Left}">
                            <Setter TargetName="PumpLabelRight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PumpLabelLeft" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="LabelPlacement"
                                 Value="{x:Static controls:PumpLabelPlacement.Top}">
                            <Setter TargetName="PumpLabelRight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PumpLabelTop" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="LabelPlacement"
                                 Value="{x:Static controls:PumpLabelPlacement.Bottom}">
                            <Setter TargetName="PumpLabelRight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PumpLabelBottom" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsRunning" Value="True">
                            <Setter TargetName="PumpBody" Property="Fill"
                                    Value="{StaticResource DeviceActiveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsInterlockReleased" Value="True">
                            <Setter TargetName="InterlockLamp" Property="Fill" Value="#20D34A"/>
                        </Trigger>
                        <Trigger Property="IsFaulted" Value="True">
                            <Setter TargetName="PumpBody" Property="Fill"
                                    Value="{StaticResource DeviceFaultBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlowPathStyle" TargetType="{x:Type Path}">
        <Setter Property="Stroke" Value="{StaticResource PipeFlowBrush}"/>
        <Setter Property="StrokeThickness" Value="6"/>
        <Setter Property="StrokeDashArray" Value="1.5,1"/>
        <Setter Property="StrokeStartLineCap" Value="Flat"/>
        <Setter Property="StrokeEndLineCap" Value="Flat"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlowing, RelativeSource={RelativeSource TemplatedParent}}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 直管：横管与竖管使用不同的规范化矢量，大小可自由拉伸。 -->
    <Style TargetType="{x:Type controls:StraightPipeControl}">
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="MinHeight" Value="12"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StraightPipeControl}">
                    <Grid ClipToBounds="True" Background="Transparent">
                        <Viewbox x:Name="HorizontalPipe"
                                 Stretch="Fill"
                                 StretchDirection="Both">
                            <Canvas Width="100" Height="24">
                                <Path Data="M 0,12 L 100,12"
                                      Stroke="{StaticResource PipeBodyBrush}"
                                      StrokeThickness="{TemplateBinding PipeThickness}"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"/>
                                <Path x:Name="PART_HorizontalFlowPath"
                                      Data="M 0,12 L 100,12"
                                      Style="{StaticResource FlowPathStyle}"/>
                                <Line X1="0" Y1="3" X2="100" Y2="3"
                                      Stroke="#66727E" StrokeThickness="1.5"/>
                                <Line X1="0" Y1="21" X2="100" Y2="21"
                                      Stroke="#66727E" StrokeThickness="1.5"/>
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="VerticalPipe"
                                 Visibility="Collapsed"
                                 Stretch="Fill"
                                 StretchDirection="Both">
                            <Canvas Width="24" Height="100">
                                <Path Data="M 12,0 L 12,100"
                                      Stroke="{StaticResource PipeBodyBrush}"
                                      StrokeThickness="{TemplateBinding PipeThickness}"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"/>
                                <Path x:Name="PART_VerticalFlowPath"
                                      Data="M 12,0 L 12,100"
                                      Style="{StaticResource FlowPathStyle}"/>
                                <Line X1="3" Y1="0" X2="3" Y2="100"
                                      Stroke="#66727E" StrokeThickness="1.5"/>
                                <Line X1="21" Y1="0" X2="21" Y2="100"
                                      Stroke="#66727E" StrokeThickness="1.5"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="HorizontalPipe" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="VerticalPipe" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 弯头：基础图形连接上方和右侧，通过旋转形成四种方向。 -->
    <Style TargetType="{x:Type controls:ElbowPipeControl}">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ElbowPipeControl}">
                    <Grid ClipToBounds="False" Background="Transparent">
                        <Viewbox Stretch="Fill" StretchDirection="Both">
                            <Canvas Width="100" Height="100">
                                <Grid x:Name="ElbowVisual"
                                      Width="100" Height="100"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Grid.RenderTransform>
                                    <Path Data="M 50,0 L 50,50 L 100,50"
                                          Stroke="{StaticResource PipeBodyBrush}"
                                          StrokeThickness="{TemplateBinding PipeThickness}"
                                          StrokeStartLineCap="Square"
                                          StrokeEndLineCap="Square"
                                          StrokeLineJoin="Round"/>
                                    <Path x:Name="PART_FlowPath"
                                          Data="M 50,0 L 50,50 L 100,50"
                                          Style="{StaticResource FlowPathStyle}"/>
                                    <Path Data="M 41,0 L 41,41 Q 41,59 59,59 L 100,59"
                                          Fill="Transparent"
                                          Stroke="#66727E"
                                          StrokeThickness="1.5"/>
                                    <Path Data="M 59,0 L 59,41 L 100,41"
                                          Fill="Transparent"
                                          Stroke="#66727E"
                                          StrokeThickness="1.5"/>
                                </Grid>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation"
                                 Value="{x:Static controls:ElbowOrientation.BottomRight}">
                            <Setter TargetName="ElbowVisual" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Orientation"
                                 Value="{x:Static controls:ElbowOrientation.BottomLeft}">
                            <Setter TargetName="ElbowVisual" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Orientation"
                                 Value="{x:Static controls:ElbowOrientation.TopLeft}">
                            <Setter TargetName="ElbowVisual" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="270"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
